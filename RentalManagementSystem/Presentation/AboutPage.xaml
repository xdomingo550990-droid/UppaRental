<Window x:Class="RentalManagementSystem.Presentation.AboutPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About - Uppa Rental Management System"
        Width="1440"
        Height="900"
        WindowStartupLocation="CenterScreen">


    <Window.Resources>
        <LinearGradientBrush x:Key="GreenGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1B3A2A" Offset="0"/>
            <GradientStop Color="#27894C" Offset="1"/>
        </LinearGradientBrush>

        <!-- White rounded card -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="28"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.10"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B3A2A"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,70,0,8"/>
        </Style>

        <Style x:Key="SectionSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,32"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1B3A2A"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>

        <Style x:Key="CardText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="22"/>
        </Style>

        <!-- Round gradient icon badge -->
        <Style x:Key="IconBadge" TargetType="Border">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Background" Value="{StaticResource GreenGradient}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{StaticResource GreenGradient}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="22"
                                Padding="22,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Fade/slide the whole page in when it opens -->
    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="PageContent"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.7"/>
                    <DoubleAnimation Storyboard.TargetName="PageContent"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="40" To="0" Duration="0:0:0.7">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="PageContent" Opacity="0">
            <StackPanel.RenderTransform>
                <TranslateTransform/>
            </StackPanel.RenderTransform>

            <!-- ============ TOP BAR ============ -->
            <Grid Margin="80,28,80,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Resources/Icons/houseLogo.png" Height="36" Margin="0,0,10,0"/>
                    <TextBlock Text="Uppa." FontSize="30" FontWeight="Bold" Foreground="#1B3A2A"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="&#x2190;  Back to Home" Style="{StaticResource PillButton}"
                        HorizontalAlignment="Right" Click="BackButton_Click"/>
            </Grid>

            <!-- ============ HERO ============ -->
            <StackPanel Margin="0,70,0,0" HorizontalAlignment="Center" MaxWidth="900">
                <TextBlock HorizontalAlignment="Center" FontSize="64" FontWeight="Bold"
                           Foreground="{StaticResource GreenGradient}">
                    <Run Text="About"/>
                    <Run Text="Uppa." Foreground="#9C8159" FontStyle="Italic"/>
                </TextBlock>
                <TextBlock Margin="0,18,0,0" FontSize="18" Foreground="#333333" TextAlignment="Center"
                           TextWrapping="Wrap" LineHeight="30"
                           Text="Unified Property Rental Administration(Uppa.) is an all-in-one rental management platform that helps property owners and managers handle units, renters, reservations, billing and reports, everything in one place."/>
            </StackPanel>

            <!-- STATS  -->
            <UniformGrid Columns="3" Margin="120,60,120,0" HorizontalAlignment="Stretch">
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="50+" FontSize="44" FontWeight="Bold" HorizontalAlignment="Center"
                                   Foreground="{StaticResource GreenGradient}"/>
                        <TextBlock Text="Units managed" FontSize="15" Foreground="#555555" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="12,0">
                    <StackPanel>
                        <TextBlock Text="1,200+" FontSize="44" FontWeight="Bold" HorizontalAlignment="Center"
                                   Foreground="{StaticResource GreenGradient}"/>
                        <TextBlock Text="Happy renters" FontSize="15" Foreground="#555555" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="12,0,0,0">
                    <StackPanel>
                        <TextBlock Text="99%" FontSize="44" FontWeight="Bold" HorizontalAlignment="Center"
                                   Foreground="{StaticResource GreenGradient}"/>
                        <TextBlock Text="On-time billing" FontSize="15" Foreground="#555555" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- WHAT WE OFFER-->
            <TextBlock Text="Features" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Everything you need to run your rental business smoothly."
                       Style="{StaticResource SectionSub}"/>

            <UniformGrid Columns="4" Margin="120,0">
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <Border Style="{StaticResource IconBadge}">
                            <TextBlock Text="&#x1F3E0;" FontFamily="Segoe UI Emoji" FontSize="24" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Units" Style="{StaticResource CardTitle}"/>
                        <TextBlock Style="{StaticResource CardText}"
                                   Text="Keep every property and unit organized, with availability and details at a glance."/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="10,0">
                    <StackPanel>
                        <Border Style="{StaticResource IconBadge}">
                            <TextBlock Text="&#x1F465;" FontFamily="Segoe UI Emoji" FontSize="24" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Renters" Style="{StaticResource CardTitle}"/>
                        <TextBlock Style="{StaticResource CardText}"
                                   Text="Track renter profiles, reservations and messages in a single place."/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="10,0">
                    <StackPanel>
                        <Border Style="{StaticResource IconBadge}">
                            <TextBlock Text="&#x1F4B3;" FontFamily="Segoe UI Emoji" FontSize="24" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Billing" Style="{StaticResource CardTitle}"/>
                        <TextBlock Style="{StaticResource CardText}"
                                   Text="Generate bills, record payments and never lose track of who has paid."/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="10,0,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource IconBadge}">
                            <TextBlock Text="&#x1F4CA;" FontFamily="Segoe UI Emoji" FontSize="24" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Reports" Style="{StaticResource CardTitle}"/>
                        <TextBlock Style="{StaticResource CardText}"
                                   Text="See income, occupancy and trends with clear, easy-to-read reports."/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!--  MISSION & VISION -->
            <TextBlock Text="Our story" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Why we built Uppa and where we're headed." Style="{StaticResource SectionSub}"/>

            <UniformGrid Columns="2" Margin="120,0">
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Mission" FontSize="22" FontWeight="Bold" Foreground="#1B3A2A"/>
                        <TextBlock Style="{StaticResource CardText}" Margin="0,10,0,0" FontSize="15"
                                   Text="To create a simple rental system that makes finding and managing homes easier."/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="12,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Vision" FontSize="22" FontWeight="Bold" Foreground="#9C8159"/>
                        <TextBlock Style="{StaticResource CardText}" Margin="0,10,0,0" FontSize="15"
                                   Text="A future where technology makes renting more convenient, organized, and accessible for everyone."/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ============ CONTACT BAND ============ -->
            <Border Margin="120,80,120,60" CornerRadius="24" Padding="40"
                    Background="{StaticResource GreenGradient}">
                <StackPanel>
                    <TextBlock Text="Get in touch" FontSize="30" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="We'd love to hear from you." FontSize="15" Foreground="#CFE8D8"
                               HorizontalAlignment="Center" Margin="0,6,0,28"/>

                    <UniformGrid Columns="3">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="EMAIL" FontSize="12" FontWeight="SemiBold" Foreground="#CFE8D8"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="dsa@uppa.com" FontSize="17" Foreground="White" Margin="0,4,0,0"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="PHONE" FontSize="12" FontWeight="SemiBold" Foreground="#CFE8D8"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="+63 9075896311" FontSize="17" Foreground="White" Margin="0,4,0,0"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="ADDRESS" FontSize="12" FontWeight="SemiBold" Foreground="#CFE8D8"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Matina, Davao City, Philippines" FontSize="17" Foreground="White" Margin="0,4,0,0"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <TextBlock Text="&#169; 2026 Uppa. All rights reserved." FontSize="12" Foreground="#888888"
                       HorizontalAlignment="Center" Margin="0,0,0,30"/>
        </StackPanel>
    </ScrollViewer>
</Window>
