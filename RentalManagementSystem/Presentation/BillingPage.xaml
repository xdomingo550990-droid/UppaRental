<UserControl x:Class="RentalManagementSystem.Presentation.BillingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/PageStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Billing and Payments: Rent Ledger" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Track invoices, collected rent, and outstanding balances." Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
            <Button Grid.Column="1" Content="+ Create Invoice" Style="{StaticResource PrimaryButton}"
                    VerticalAlignment="Center" Click="CreateInvoice_Click"/>
        </Grid>

        <!-- 2. Summary cards -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Background="#1E3223" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="Total collected" Style="{StaticResource StatLabel}" Foreground="#C9D8CC"/>
                    <TextBlock x:Name="txtCollected" Text="₱0.00" Style="{StaticResource StatValue}" Foreground="White"/>
                    <TextBlock x:Name="txtCollectedNote" Text="" Style="{StaticResource StatNote}" Foreground="#C9D8CC"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="Pending" Style="{StaticResource StatLabel}"/>
                    <TextBlock x:Name="txtPending" Text="₱0.00" Style="{StaticResource StatValue}" Foreground="#8C6B00"/>
                    <TextBlock x:Name="txtPendingNote" Text="" Style="{StaticResource StatNote}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="Overdue" Style="{StaticResource StatLabel}"/>
                    <TextBlock x:Name="txtOverdue" Text="₱0.00" Style="{StaticResource StatValue}" Foreground="#A81C0C"/>
                    <TextBlock x:Name="txtOverdueNote" Text="" Style="{StaticResource StatNote}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. Filters + search -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,20">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <RadioButton x:Name="rbAll" Content="All" Tag="All" IsChecked="True"
                                 Style="{StaticResource FilterPill}" Checked="Filter_Checked"/>
                    <RadioButton x:Name="rbPaid" Content="Paid" Tag="Paid"
                                 Style="{StaticResource FilterPill}" Checked="Filter_Checked"/>
                    <RadioButton x:Name="rbPendingFilter" Content="Pending" Tag="Pending"
                                 Style="{StaticResource FilterPill}" Checked="Filter_Checked"/>
                    <RadioButton x:Name="rbOverdue" Content="Overdue" Tag="Overdue"
                                 Style="{StaticResource FilterPill}" Checked="Filter_Checked"/>
                </StackPanel>

                <Border Style="{StaticResource InputBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#607464"
                                   VerticalAlignment="Center" Margin="14,0,0,0"/>
                        <TextBox x:Name="txtSearch" Grid.Column="1" Style="{StaticResource PlainTextBox}"
                                 TextChanged="Search_TextChanged"/>
                        <TextBlock Grid.Column="1" Text="Search invoice #, renter, or unit..." IsHitTestVisible="False"
                                   Foreground="#8C9E90" FontSize="13" VerticalAlignment="Center" Margin="14,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=txtSearch}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- 4. Invoices table -->
        <Border Grid.Row="3" Style="{StaticResource Card}">
            <DataGrid x:Name="dgInvoices" Style="{StaticResource AppDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="INVOICE #" Binding="{Binding InvoiceNo}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#27894C"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="RENTER" Binding="{Binding Renter}" Width="*"/>
                    <DataGridTextColumn Header="UNIT" Binding="{Binding Unit}" Width="100"/>
                    <DataGridTextColumn Header="PERIOD" Binding="{Binding Period}" Width="110"/>
                    <DataGridTextColumn Header="DUE DATE" Binding="{Binding DueDate}" Width="120"/>
                    <DataGridTextColumn Header="AMOUNT" Binding="{Binding AmountText}" Width="130">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="STATUS" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource StatusBadge}">
                                    <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="Bold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="ACTIONS" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="View" Style="{StaticResource LinkButton}" Click="View_Click"/>
                                    <Button Content="Mark Paid" Click="MarkPaid_Click">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Paid">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>