<UserControl x:Class="RentalManagementSystem.Presentation.BillingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border Background="White" CornerRadius="12" Padding="20">
            <Border.Effect>
                <DropShadowEffect Color="#1E3223" Direction="270" ShadowDepth="5" BlurRadius="20" Opacity="0.15"/>
            </Border.Effect>
            <TextBlock Text="Billing, Invoices &amp; Payments View" FontSize="18" FontWeight="SemiBold" Foreground="#1E3223" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>