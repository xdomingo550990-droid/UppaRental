<Window x:Class="RentalManagementSystem.Presentation.DashboardPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RentalManagementSystem.Presentation"
        mc:Ignorable="d"
        Title="Uppa - Rental Management System"  
        Width="1440"
        Height="900"
        WindowStartupLocation="CenterScreen"
        Background="#C2D3C4">

    <Window.Resources>
        <!-- Custom Button Style for Navigation Items -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#1E3223"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="16,0,0,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="12" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#A2BBA6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active Navigation Item Style -->
        <Style x:Key="ActiveNavButtonStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
            <Setter Property="Background" Value="#A2BBA6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR -->
        <Grid Grid.Column="0" Margin="16,20,10,20">
            <Grid.RowDefinitions>
                <!-- Brand Header -->
                <RowDefinition Height="Auto"/>
                <!-- Category Label -->
                <RowDefinition Height="Auto"/>
                <!-- Navigation Items -->
                <RowDefinition Height="*"/>
                <!-- User Profile Card -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Brand Section -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,0,0,20">
                <Border Width="40" Height="40" CornerRadius="20" Background="#1E3223" Margin="0,0,12,0">
                    <TextBlock Text="U" Foreground="White" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="UPPA RENTAL" FontWeight="Bold" FontSize="15" Foreground="#1E3223"/>
                    <TextBlock Text="HOST CONSOLE" FontSize="11" Foreground="#C07156" FontWeight="SemiBold"/>
                </StackPanel>
            </StackPanel>

            <!-- Navigation Label -->
            <TextBlock Grid.Row="1" Text="MENU" FontSize="11" FontWeight="Bold" Foreground="#607464" Margin="12,0,0,8"/>

            <!-- Menu Buttons -->
            <StackPanel Grid.Row="2">
                <Button x:Name="btnOverview" Style="{StaticResource ActiveNavButtonStyle}" Click="NavButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⌂" FontSize="16" Margin="0,0,12,0"/>
                        <TextBlock Text="Overview" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="btnUnits" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🚪" FontSize="14" Margin="0,0,12,0"/>
                        <TextBlock Text="Units" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                
                <Button x:Name="btnReservations" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📅" FontSize="14" Margin="0,0,12,0"/>
                        <TextBlock Text="Reservations" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="btnRenters" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="👤" FontSize="14" Margin="0,0,12,0"/>
                        <TextBlock Text="Renters" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="btnBilling" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💳" FontSize="14" Margin="0,0,12,0"/>
                        <TextBlock Text="Billing and Payments" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="btnMessages" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💬" FontSize="14" Margin="0,0,12,0"/>
                        <TextBlock Text="Messages" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="btnReports" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📈" FontSize="14" Margin="0,0,12,0"/>
                        <TextBlock Text="Reports" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="btnSettings" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚙" FontSize="14" Margin="0,0,12,0"/>
                        <TextBlock Text="Settings" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource NavButtonStyle}" 
                        Foreground="#C84B41" 
                        Margin="0,12,0,0"
                        Click="LogOutButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⎋" FontSize="16" Margin="0,0,12,0"/>
                        <TextBlock Text="Log Out" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Bottom Profile Card -->
            <Border Grid.Row="3" Background="#E8EFE9" CornerRadius="12" Padding="12" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="36" Height="36" CornerRadius="18" Background="#1E3223" Margin="0,0,10,0">
                        <TextBlock Text="X" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Kim Vincent Domingo" FontWeight="Bold" FontSize="13" Foreground="#1E3223"/>
                        <TextBlock Text="Landlord • 6 units" FontSize="11" Foreground="#607464"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- MAIN CONTENT AREA -->
        <Border Grid.Column="1" CornerRadius="20,0,0,0" Margin="0,10,0,0" Background="#FFD5E2D7">
            <Grid Margin="24,16,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top Header Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Page Title -->
                     <TextBlock x:Name="txtPageTitle" Grid.Column="0" Text="Overview" FontSize="26" FontWeight="Bold" Foreground="#1E3223" VerticalAlignment="Center"/>

                    <!-- Search Bar -->
                    <Border Grid.Column="1" HorizontalAlignment="Right" Width="350" Height="38" Background="#E8EFE9" CornerRadius="19" Padding="14,0" Margin="0,0,20,0">
                        <Grid VerticalAlignment="Center">
                            <TextBlock Text="Search..." Foreground="#8C9E90" FontSize="13" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    
                </Grid>

                <!-- Dynamic View Frame -->
                <ContentControl x:Name="MainContentFrame" Grid.Row="1" />
            </Grid>
        </Border>
    </Grid>
</Window>