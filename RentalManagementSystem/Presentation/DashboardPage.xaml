<Window x:Class="RentalManagementSystem.Presentation.DashboardPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RentalManagementSystem.Presentation"
        mc:Ignorable="d"
        Title="Uppa - Rental Management System"  
        Width="1440"
        Height="900"
        WindowStartupLocation="CenterScreen"
        Background="#C2D3C4">

    <Window.Resources>
        <!-- Custom Button Style for Navigation Items -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#1E3223"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="16,0,0,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="12" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#A2BBA6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active Navigation Item Style -->
        <Style x:Key="ActiveNavButtonStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
            <Setter Property="Background" Value="#A2BBA6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR -->
        <Grid Grid.Column="0" Margin="16,20,10,20">
            <Grid.RowDefinitions>
                <!-- Brand Header -->
                <RowDefinition Height="Auto"/>
                <!-- Category Label -->
                <RowDefinition Height="Auto"/>
                <!-- Navigation Items -->
                <RowDefinition Height="*"/>
                <!-- User Profile Card -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Brand Section -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,0,0,20">
                <Border Width="40" Height="40" CornerRadius="20" Background="#1E3223" Margin="0,0,12,0">
                    <TextBlock Text="U" Foreground="White" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="UPPA RENTAL" FontWeight="Bold" FontSize="15" Foreground="#1E3223"/>
                    <TextBlock Text="HOST CONSOLE" FontSize="11" Foreground="#C07156" FontWeight="SemiBold"/>
                </StackPanel>
            </StackPanel>

            <!-- Navigation Label -->
            <TextBlock Grid.Row="1" Text="MENU" FontSize="11" FontWeight="Bold" Foreground="#607464" Margin="12,0,0,8"/>

            <!-- Menu Buttons -->
            <StackPanel Grid.Row="2">
                <Button Style="{StaticResource ActiveNavButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⌂" FontSize="16" Margin="0,0,12,0"/>
                        <TextBlock Text="Overview" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource NavButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📅" FontSize="14" Margin="0,0,12,0"/>
                        <TextBlock Text="Reservations" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource NavButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="👤" FontSize="14" Margin="0,0,12,0"/>
                        <TextBlock Text="Renters" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource NavButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💳" FontSize="14" Margin="0,0,12,0"/>
                        <TextBlock Text="Billing and Payments" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource NavButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💬" FontSize="14" Margin="0,0,12,0"/>
                        <TextBlock Text="Messages" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource NavButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📈" FontSize="14" Margin="0,0,12,0"/>
                        <TextBlock Text="Reports" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource NavButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚙" FontSize="14" Margin="0,0,12,0"/>
                        <TextBlock Text="Settings" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource NavButtonStyle}" 
                        Foreground="#C84B41" 
                        Margin="0,12,0,0"
                        Click="LogOutButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⎋" FontSize="16" Margin="0,0,12,0"/>
                        <TextBlock Text="Log Out" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Bottom Profile Card -->
            <Border Grid.Row="3" Background="#E8EFE9" CornerRadius="12" Padding="12" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="36" Height="36" CornerRadius="18" Background="#1E3223" Margin="0,0,10,0">
                        <TextBlock Text="X" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Kim Vincent Domingo" FontWeight="Bold" FontSize="13" Foreground="#1E3223"/>
                        <TextBlock Text="Landlord • 6 units" FontSize="11" Foreground="#607464"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- MAIN CONTENT AREA -->
        <Border Grid.Column="1" CornerRadius="20,0,0,0" Margin="0,10,0,0" Background="#FFD5E2D7">
            <Grid Margin="24,16,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top Header Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Page Title -->
                    <TextBlock Grid.Column="0" Text="Overview" FontSize="26" FontWeight="Bold" Foreground="#1E3223" VerticalAlignment="Center"/>

                    <!-- Search Bar -->
                    <Border Grid.Column="1" HorizontalAlignment="Right" Width="350" Height="38" Background="#E8EFE9" CornerRadius="19" Padding="14,0" Margin="0,0,20,0">
                        <Grid VerticalAlignment="Center">
                            <TextBlock Text="Search..." Foreground="#8C9E90" FontSize="13" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    
                </Grid>

                <!-- Main Overview Viewport -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 1. Four Horizontal Summary Cards -->
                    <UniformGrid Grid.Row="0" Columns="4" Height="100" Margin="0,0,0,24">

                        <!-- Card 1: Revenue -->
                        <Border Margin="0,0,12,0" CornerRadius="12">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Color="#FAF3DA" Offset="0"/>
                                    <GradientStop Color="#F0E4BE" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel Margin="18,14">
                                <TextBlock Text="Revenue" FontSize="13" FontWeight="SemiBold" Foreground="#607464"/>
                                <TextBlock Text="₱120,000" FontSize="22" FontWeight="Bold" Foreground="#1E3223" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Total Units -->
                        <Border Margin="6,0,6,0" CornerRadius="12">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Color="#E4EEE3" Offset="0"/>
                                    <GradientStop Color="#D0E0CE" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel Margin="18,14">
                                <TextBlock Text="Total Units" FontSize="13" FontWeight="SemiBold" Foreground="#607464"/>
                                <TextBlock Text="20" FontSize="24" FontWeight="Bold" Foreground="#1E3223" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Available -->
                        <Border Margin="6,0,6,0" CornerRadius="12">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Color="#D7EBDD" Offset="0"/>
                                    <GradientStop Color="#A2CBA8" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel Margin="18,14">
                                <TextBlock Text="Available" FontSize="13" FontWeight="SemiBold" Foreground="#607464"/>
                                <TextBlock Text="8" FontSize="24" FontWeight="Bold" Foreground="#1E3223" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 4: Occupied -->
                        <Border Margin="12,0,0,0" CornerRadius="12">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Color="#FCE4DC" Offset="0"/>
                                    <GradientStop Color="#F2CDC3" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel Margin="18,14">
                                <TextBlock Text="Occupied" FontSize="13" FontWeight="SemiBold" Foreground="#607464"/>
                                <TextBlock Text="7" FontSize="24" FontWeight="Bold" Foreground="#1E3223" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                    </UniformGrid>

                    <!-- 2. Room Status Section Title -->
                    <TextBlock Grid.Row="1" Text="ROOM STATUS" FontSize="15" FontWeight="Bold" Foreground="#1E3223" Margin="2,0,0,12"/>

                    <!-- 3. Room Status Data Grid Table -->
                    <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="12">
                        <DataGrid x:Name="dgRoomStatus" 
                  AutoGenerateColumns="False" 
                  CanUserAddRows="False" 
                  IsReadOnly="True" 
                  HeadersVisibility="Column"
                  Background="Transparent" 
                  BorderThickness="0" 
                  RowHeight="40"
                  GridLinesVisibility="Horizontal" 
                  HorizontalGridLinesBrush="#EFEFEF">

                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#E8EFE9"/>
                                    <Setter Property="Foreground" Value="#1E3223"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Height" Value="38"/>
                                    <Setter Property="Padding" Value="12,0"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Padding" Value="6,0"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F5F8F5"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Room No." Binding="{Binding RoomNo}" Width="*"/>
                                <DataGridTextColumn Header="Room Type" Binding="{Binding RoomType}" Width="*"/>
                                <DataGridTextColumn Header="Monthly Rate" Binding="{Binding MonthlyRate}" Width="*"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>