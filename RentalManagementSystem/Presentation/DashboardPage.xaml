<Window x:Class="RentalManagementSystem.Presentation.DashboardPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RentalManagementSystem.Presentation"
        mc:Ignorable="d"
        Title="Uppa - Rental Management System"
        Width="1440"
        Height="825"
        WindowStartupLocation="CenterScreen"
        Background="#C2D3C4">

    <Window.Resources>

        <!-- Sidebar colors -->
        <SolidColorBrush x:Key="NavText" Color="#DCE8DE"/>
        <SolidColorBrush x:Key="NavHover" Color="#1FFFFFFF"/>
        <SolidColorBrush x:Key="NavActive" Color="#33FFFFFF"/>
        <SolidColorBrush x:Key="Accent" Color="#C07156"/>

        <!-- Nav item: RadioButton so "active" state is automatic (IsChecked).
             Tag = icon glyph (Segoe MDL2 Assets), Content = label. -->
        <Style x:Key="NavItemStyle" TargetType="RadioButton">
            <Setter Property="GroupName" Value="MainNav"/>
            <Setter Property="Foreground" Value="{StaticResource NavText}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bg" Height="44" Margin="0,2" CornerRadius="12" Background="Transparent">
                            <Grid>
                                <Border x:Name="accent" Width="3" Height="20" CornerRadius="2"
                                        Background="{StaticResource Accent}"
                                        HorizontalAlignment="Left" Visibility="Collapsed"/>
                                <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{TemplateBinding Tag}"
                                               FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               Width="24" TextAlignment="Center" VerticalAlignment="Center"/>
                                    <ContentPresenter Margin="14,0,0,0" VerticalAlignment="Center"
                                                      RecognizesAccessKey="False"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource NavHover}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource NavActive}"/>
                                <Setter TargetName="accent" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Logout: plain button, same look, warm red on hover -->
        <Style x:Key="LogoutStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#FFB4AA"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Height="44" Margin="0,2" CornerRadius="12" Background="Transparent">
                            <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}"
                                           FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Width="24" TextAlignment="Center" VerticalAlignment="Center"/>
                                <ContentPresenter Margin="14,0,0,0" VerticalAlignment="Center"
                                                  RecognizesAccessKey="False"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#33C84B41"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Round hamburger toggle -->
        <Style x:Key="ToggleButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Width="36" Height="36" CornerRadius="18" Background="Transparent">
                            <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource NavHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thin divider between groups -->
        <Style x:Key="NavDivider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="8,8"/>
            <Setter Property="Background" Value="#26FFFFFF"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR (floating, collapsible) -->
        <Border x:Name="SidebarPanel" Grid.Column="0" Width="260" Margin="16,16,6,16"
                CornerRadius="24" Padding="12" ClipToBounds="True"
                BorderBrush="#33FFFFFF" BorderThickness="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#2B4A33" Offset="0"/>
                    <GradientStop Color="#1E3223" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.25" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header: brand + toggle -->
                <Grid Grid.Row="0" Height="44" Margin="0,0,0,12">
                    <StackPanel x:Name="BrandPanel" Orientation="Horizontal" HorizontalAlignment="Left" Margin="2,0,0,0">
                        <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource Accent}" Margin="0,0,10,0">
                            <TextBlock Text="U" Foreground="White" FontWeight="Bold" FontSize="16"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="UPPA RENTAL" FontWeight="Bold" FontSize="14" Foreground="White"/>
                            <TextBlock Text="HOST CONSOLE" FontSize="10" FontWeight="SemiBold" Foreground="#E0A08A"/>
                        </StackPanel>
                    </StackPanel>
                    <Button x:Name="btnToggleSidebar" Style="{StaticResource ToggleButtonStyle}"
                            HorizontalAlignment="Right" Click="ToggleSidebar_Click"/>
                </Grid>

                <!-- Navigation -->
                <StackPanel Grid.Row="1">
                    <RadioButton x:Name="btnOverview" Style="{StaticResource NavItemStyle}"
                                 Tag="&#xE80F;" Content="Overview" IsChecked="True" Click="NavButton_Click"/>
                    <RadioButton x:Name="btnProperties" Style="{StaticResource NavItemStyle}"
                                 Tag="&#xE71D;" Content="Properties" Click="NavButton_Click"/>

                    <Border Style="{StaticResource NavDivider}"/>

                    <RadioButton x:Name="btnReservations" Style="{StaticResource NavItemStyle}"
                                 Tag="&#xE787;" Content="Reservation" Click="NavButton_Click"/>
                    <RadioButton x:Name="btnRenters" Style="{StaticResource NavItemStyle}"
                                 Tag="&#xE77B;" Content="Renters" Click="NavButton_Click"/>
                    <RadioButton x:Name="btnBilling" Style="{StaticResource NavItemStyle}"
                                 Tag="&#xE8C7;" Content="Billing and Payments" Click="NavButton_Click"/>
                    <RadioButton x:Name="btnMessages" Style="{StaticResource NavItemStyle}"
                                 Tag="&#xE8BD;" Content="Messages" Click="NavButton_Click"/>
                    <RadioButton x:Name="btnReports" Style="{StaticResource NavItemStyle}"
                                 Tag="&#xE9D2;" Content="Reports" Click="NavButton_Click"/>

                    <Border Style="{StaticResource NavDivider}"/>

                    <RadioButton x:Name="btnSettings" Style="{StaticResource NavItemStyle}"
                                 Tag="&#xE713;" Content="Settings" Click="NavButton_Click"/>
                    <Button x:Name="btnLogout" Style="{StaticResource LogoutStyle}"
                            Tag="&#xE7E8;" Content="Logout" Click="LogOutButton_Click"/>
                </StackPanel>

                <!-- Bottom profile -->
                <Border Grid.Row="2" Background="#1AFFFFFF" CornerRadius="14" Padding="6" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource Accent}" Margin="0,0,10,0">
                            <TextBlock Text="K" Foreground="White" FontWeight="Bold" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Kim Vincent Domingo" FontWeight="Bold" FontSize="13" Foreground="White"/>
                            <TextBlock Text="Landlord • 6 units" FontSize="11" Foreground="#A9BFAE"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <Border Grid.Column="1" CornerRadius="24" Margin="6,16,16,16" Background="#FFD5E2D7">
            <Grid Margin="24,16,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top Header Bar: page title + search bar -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Page Title -->
                    <TextBlock x:Name="txtPageTitle" Grid.Column="0" Text="Overview" FontSize="26" FontWeight="Bold"
                               Foreground="#1E3223" VerticalAlignment="Center"/>

                    <!-- Search Bar (next to the title) -->
                    <Border Grid.Column="1" HorizontalAlignment="Left" Width="350" Height="38"
                            Margin="24,0,0,0" Background="#E8EFE9" CornerRadius="19" Padding="14,0">
                        <Grid VerticalAlignment="Center">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="#607464" VerticalAlignment="Center" HorizontalAlignment="Left"/>

                            <TextBox x:Name="txtSearch" Margin="26,0,0,0" Background="Transparent"
                                     BorderThickness="0" FontSize="13" Foreground="#1E3223"
                                     VerticalContentAlignment="Center"/>

                            <!-- Placeholder: disappears when you type -->
                            <TextBlock Text="Search..." IsHitTestVisible="False" Margin="28,0,0,0"
                                       Foreground="#8C9E90" FontSize="13" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=txtSearch}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Dynamic View Frame (Overview content is the default) -->
                <ContentControl x:Name="MainContentFrame" Grid.Row="1">
                    <Grid>
                        <Grid.Resources>

                            <!-- Placeholder photo for all cards (swap per card later) -->
                            <ImageBrush x:Key="HouseBrush" ImageSource="/Resources/Images/houseImage1.jpg" Stretch="UniformToFill"/>

                            <!-- Category chip -->
                            <Style x:Key="ChipStyle" TargetType="RadioButton">
                                <Setter Property="GroupName" Value="Category"/>
                                <Setter Property="Foreground" Value="#1E3223"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Margin" Value="0,0,10,0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="chip" Padding="20,9" CornerRadius="18" Background="White">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.12"/>
                                                </Border.Effect>
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="chip" Property="Background" Value="#F1F5F2"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="chip" Property="Background" Value="#1E3223"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <!-- Property card -->
                            <Style x:Key="PropCard" TargetType="Border">
                                <Setter Property="Width" Value="270"/>
                                <Setter Property="Margin" Value="0,0,20,24"/>
                                <Setter Property="Padding" Value="14"/>
                                <Setter Property="CornerRadius" Value="28"/>
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#9FB1BC" Offset="0"/>
                                            <GradientStop Color="#7F9A78" Offset="0.55"/>
                                            <GradientStop Color="#6E8F4F" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.22"/>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <Style x:Key="CardTitle" TargetType="TextBlock">
                                <Setter Property="FontSize" Value="18"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="0,2,0,0"/>
                            </Style>
                            <Style x:Key="CardOwner" TargetType="TextBlock">
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Foreground" Value="#EAF0EB"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                            <Style x:Key="CardLabel" TargetType="TextBlock">
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Foreground" Value="#D9E2DA"/>
                            </Style>
                            <Style x:Key="CardValue" TargetType="TextBlock">
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#F5C542"/>
                                <Setter Property="Margin" Value="0,2,0,0"/>
                            </Style>
                        </Grid.Resources>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Heading -->
                        <TextBlock Grid.Row="0" HorizontalAlignment="Center" Margin="0,8,0,20"
                                   FontSize="30" FontWeight="Bold" Foreground="#1E3223">
                            <Run Text="Ready to Find Your "/>
                            <Run Text="Dream" FontFamily="Georgia" FontStyle="Italic" Foreground="#C9972B"/>
                            <Run Text=" Property?"/>
                        </TextBlock>

                        <!-- Category chips -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,28">
                            <RadioButton Style="{StaticResource ChipStyle}" Content="All" IsChecked="True"/>
                            <RadioButton Style="{StaticResource ChipStyle}" Content="Cottage"/>
                            <RadioButton Style="{StaticResource ChipStyle}" Content="Chalet"/>
                            <RadioButton Style="{StaticResource ChipStyle}" Content="Penthouse"/>
                            <RadioButton Style="{StaticResource ChipStyle}" Content="Farmhouse"/>
                        </StackPanel>

                        <!-- Property cards (scroll sideways) -->
                        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="4,0,0,0">

                                <!-- Card 1 -->
                                <Border Style="{StaticResource PropCard}">
                                    <StackPanel>
                                        <Border Height="200" CornerRadius="22" Background="{StaticResource HouseBrush}">
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0"
                                                    Width="32" Height="32" CornerRadius="16" Background="#80333F3A">
                                                <TextBlock Text="♡" FontFamily="Segoe UI Symbol" FontSize="16" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                                            <TextBlock Text="Uppa Rental" Style="{StaticResource CardOwner}"/>
                                            <Border Width="14" Height="14" CornerRadius="7" Background="#F5C542" Margin="6,0,0,0">
                                                <TextBlock Text="✓" FontSize="9" FontWeight="Bold" Foreground="#1E3223"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Unit 101" Style="{StaticResource CardTitle}"/>
                                        <Border Background="#66000000" CornerRadius="14" Padding="14,10" Margin="0,12,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Monthly rent" Style="{StaticResource CardLabel}"/>
                                                    <TextBlock Text="₱12,500" Style="{StaticResource CardValue}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                    <TextBlock Text="Status" Style="{StaticResource CardLabel}" HorizontalAlignment="Right"/>
                                                    <TextBlock Text="Occupied" Style="{StaticResource CardValue}" HorizontalAlignment="Right"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Card 2 -->
                                <Border Style="{StaticResource PropCard}">
                                    <StackPanel>
                                        <Border Height="200" CornerRadius="22" Background="{StaticResource HouseBrush}">
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0"
                                                    Width="32" Height="32" CornerRadius="16" Background="#80333F3A">
                                                <TextBlock Text="♡" FontFamily="Segoe UI Symbol" FontSize="16" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                                            <TextBlock Text="Uppa Rental" Style="{StaticResource CardOwner}"/>
                                            <Border Width="14" Height="14" CornerRadius="7" Background="#F5C542" Margin="6,0,0,0">
                                                <TextBlock Text="✓" FontSize="9" FontWeight="Bold" Foreground="#1E3223"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Unit 102" Style="{StaticResource CardTitle}"/>
                                        <Border Background="#66000000" CornerRadius="14" Padding="14,10" Margin="0,12,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Monthly rent" Style="{StaticResource CardLabel}"/>
                                                    <TextBlock Text="₱9,800" Style="{StaticResource CardValue}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                    <TextBlock Text="Status" Style="{StaticResource CardLabel}" HorizontalAlignment="Right"/>
                                                    <TextBlock Text="Vacant" Style="{StaticResource CardValue}" HorizontalAlignment="Right"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Card 3 -->
                                <Border Style="{StaticResource PropCard}">
                                    <StackPanel>
                                        <Border Height="200" CornerRadius="22" Background="{StaticResource HouseBrush}">
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0"
                                                    Width="32" Height="32" CornerRadius="16" Background="#80333F3A">
                                                <TextBlock Text="♡" FontFamily="Segoe UI Symbol" FontSize="16" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                                            <TextBlock Text="Uppa Rental" Style="{StaticResource CardOwner}"/>
                                            <Border Width="14" Height="14" CornerRadius="7" Background="#F5C542" Margin="6,0,0,0">
                                                <TextBlock Text="✓" FontSize="9" FontWeight="Bold" Foreground="#1E3223"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Unit 201" Style="{StaticResource CardTitle}"/>
                                        <Border Background="#66000000" CornerRadius="14" Padding="14,10" Margin="0,12,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Monthly rent" Style="{StaticResource CardLabel}"/>
                                                    <TextBlock Text="₱15,000" Style="{StaticResource CardValue}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                    <TextBlock Text="Status" Style="{StaticResource CardLabel}" HorizontalAlignment="Right"/>
                                                    <TextBlock Text="Occupied" Style="{StaticResource CardValue}" HorizontalAlignment="Right"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Card 4 -->
                                <Border Style="{StaticResource PropCard}">
                                    <StackPanel>
                                        <Border Height="200" CornerRadius="22" Background="{StaticResource HouseBrush}">
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0"
                                                    Width="32" Height="32" CornerRadius="16" Background="#80333F3A">
                                                <TextBlock Text="♡" FontFamily="Segoe UI Symbol" FontSize="16" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                                            <TextBlock Text="Uppa Rental" Style="{StaticResource CardOwner}"/>
                                            <Border Width="14" Height="14" CornerRadius="7" Background="#F5C542" Margin="6,0,0,0">
                                                <TextBlock Text="✓" FontSize="9" FontWeight="Bold" Foreground="#1E3223"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Unit 202" Style="{StaticResource CardTitle}"/>
                                        <Border Background="#66000000" CornerRadius="14" Padding="14,10" Margin="0,12,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Monthly rent" Style="{StaticResource CardLabel}"/>
                                                    <TextBlock Text="₱8,500" Style="{StaticResource CardValue}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                    <TextBlock Text="Status" Style="{StaticResource CardLabel}" HorizontalAlignment="Right"/>
                                                    <TextBlock Text="Reserved" Style="{StaticResource CardValue}" HorizontalAlignment="Right"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </ContentControl>
            </Grid>
        </Border>
    </Grid>
</Window>