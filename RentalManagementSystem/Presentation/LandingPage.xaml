<Window x:Class="RentalManagementSystem.Presentation.LandingPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Uppa - Rental Management System"
        Width="1440"
        Height="900"
        WindowStartupLocation="CenterScreen">

    <Grid Background="White">

        <!-- Navigation Bar -->
        <Grid Height="80"
              VerticalAlignment="Top"
              Margin="60,0,60,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <!-- Logo -->
            <TextBlock Grid.Column="0"
                       Text="Uppa."
                       FontSize="34"
                      FontWeight="Bold"
                       Foreground="#1B3A2A"
                       VerticalAlignment="Top"
                       Margin="50,22,0,0"/>


            <!-- Navigation Links -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,31,0,0">

                <Button Content="Home"
                        Margin="20,0"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="21"
                        FontWeight="SemiBold"
                        Foreground="#27894C"/>

                <Button Content="About"
                        Margin="24,0"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="21"
                        FontWeight="SemiBold"
                        Foreground="#27894C"/>

                <Button Content="Contact"
                        Margin="24,0"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="21"
                        FontWeight="SemiBold"
                        Foreground="#27894C"/>

                <Button Content="Blog"
                        Margin="24,0"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="21"
                      FontWeight="SemiBold"
                        Foreground="#27894C"/>

            </StackPanel>

            <!-- Login / Sign Up -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,35,0,0">

                <Button Content="Login"
                        Margin="10,0"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="21"
                       FontWeight="SemiBold"
                         Foreground="#27894C"
                        Click="LoginButton_Click"/>

                <Button Content="Sign Up"
                        Margin="10,0"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="21"
                        FontWeight="SemiBold"/>

            </StackPanel>
            <Image Margin="0,25,205,10" Source="/Resources/Icons/houseLogo.png" Stretch="Fill"/>

        </Grid>


        <!-- Hero Section -->
        <Grid Margin="80,100,80,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="45*"/>
                <ColumnDefinition Width="55*"/>
            </Grid.ColumnDefinitions>


            <!-- Left Side: Text -->
            <StackPanel Grid.Column="0"
                        VerticalAlignment="Top"
                        Margin="30,40,30,0">

                <TextBlock Text="Ready to"
                           FontSize="48"
                           FontWeight="Bold"
                           Foreground="#193528"/>
                <TextBlock Text="Find Your"
                           FontSize="48"
                           FontWeight="Bold"
                           Foreground="#193528"/>

                <TextBlock Text="Dream"
                           FontSize="48"
                           FontWeight="Bold"
                           Foreground="#B88958"/>

                <TextBlock Text="Property?"
                           FontSize="48"
                           FontWeight="Bold"
                           Foreground="#193528"/>

                <TextBlock Text="Everything in one place."
                           FontSize="16"
                           Foreground="#555555"
                           Margin="0,20,0,20"/>

                <Button Content="Explore the platform"
                        Width="170"
                        Height="45"
                        HorizontalAlignment="Left"
                        Background="Black"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="13"/>

            </StackPanel>


            <!-- Right Side: House Image -->
            <Image Grid.Column="1"
                   Source="/Resources/Images/landingPage.png"
                   Stretch="Uniform"
                   Margin="0,20,20,231"/>

        </Grid>

    </Grid>

</Window>