<Window x:Class="RentalManagementSystem.Presentation.LandingPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RentalManagementSystem.Presentation"
        Title="Uppa - Rental Management System"
        Width="1440"
        Height="900"
        WindowStartupLocation="CenterScreen">

    <!-- ========== Entrance animation: heading, subtext, button rise in one after another ========== -->
    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>

                    <!-- Heading: first -->
                    <DoubleAnimation Storyboard.TargetName="HeroTitle"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.8"/>
                    <DoubleAnimation Storyboard.TargetName="HeroTitle"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="60" To="0" Duration="0:0:0.8">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <!-- Subtext: 0.3s later -->
                    <DoubleAnimation Storyboard.TargetName="HeroSubtitle"
                                     Storyboard.TargetProperty="Opacity"
                                     BeginTime="0:0:0.3" From="0" To="1" Duration="0:0:0.8"/>
                    <DoubleAnimation Storyboard.TargetName="HeroSubtitle"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     BeginTime="0:0:0.3" From="40" To="0" Duration="0:0:0.8">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <!-- Button: 0.6s later -->
                    <DoubleAnimation Storyboard.TargetName="HeroButton"
                                     Storyboard.TargetProperty="Opacity"
                                     BeginTime="0:0:0.6" From="0" To="1" Duration="0:0:0.8"/>
                    <DoubleAnimation Storyboard.TargetName="HeroButton"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     BeginTime="0:0:0.6" From="30" To="0" Duration="0:0:0.8">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid>

    <Grid Margin="0,-24,0,9">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="77*"/>
            <ColumnDefinition Width="643*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="429*"/>
            <RowDefinition Height="470*"/>
        </Grid.RowDefinitions>
        <Grid.Background>
            <ImageBrush ImageSource="/Resources/Images/designLanding.png" Stretch="UniformToFill"/>
        </Grid.Background>

        <!-- Navigation Bar -->
        <Grid Height="80"
              VerticalAlignment="Top"
              Margin="60,9,60,0" Grid.ColumnSpan="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <!-- Logo -->
            <TextBlock Grid.Column="0"
                       Text="Uppa."
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="#1B3A2A"
                       VerticalAlignment="Top"
                       Margin="50,28,0,0"/>


            <!-- Navigation Links -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,31,0,0"/>

                <!-- Login / Sign Up -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,35,0,0">

                <Button Content="Login"
                        Margin="10,0"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="#27894C"
                        Click="LoginButton_Click"/>

                <Button Content="Sign Up"
                        Margin="10,0"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Click="SignUpButton_Click"/>

            </StackPanel>
            <Image Margin="0,27,205,8" Source="/Resources/Icons/houseLogo.png" Stretch="Fill"/>
        </Grid>


        <!-- Hero Section -->
        <Grid Margin="60,64,497,160" RenderTransformOrigin="0.944,0.476" Grid.RowSpan="2" Grid.ColumnSpan="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="45*"/>
                <ColumnDefinition Width="55*"/>
            </Grid.ColumnDefinitions>


            <!-- Left Side: Text -->
            <StackPanel Grid.Column="0"
                        VerticalAlignment="Top"
                        Margin="10,148,50,0">


                <!-- Main Heading -->
                <TextBlock x:Name="HeroTitle" Opacity="0"
                           FontSize="63"
                           FontWeight="Bold"
                           LineHeight="55"
                           LineStackingStrategy="BlockLineHeight">
                    <TextBlock.RenderTransform>
                        <TranslateTransform/>
                    </TextBlock.RenderTransform>
                    <TextBlock.Foreground>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1B3A2A" Offset="0"/>
                            <GradientStop Color="#27894C" Offset="1"/>
                        </LinearGradientBrush>
                    </TextBlock.Foreground>

                    <Run Text="Ready to"/>
                    <LineBreak/>
                    <Run Text="Find Your"/>
                    <LineBreak/>
                    <Run Text="Dream" Foreground="#9C8159" FontStyle="Italic"/>
                    <LineBreak/>
                    <Run Text="Property?"/>
                </TextBlock>

                <!-- Subtext -->
                <TextBlock x:Name="HeroSubtitle" Opacity="0"
                           Text="Everything in one place."
                           FontSize="18"
                           Foreground="#333333"
                           Margin="5,25,0,30">
                    <TextBlock.RenderTransform>
                        <TranslateTransform/>
                    </TextBlock.RenderTransform>
                </TextBlock>

                <!-- Explore Button -->
                <Button x:Name="HeroButton" Opacity="0"
                        Width="220"
                        Height="50"
                        Foreground="White"
                        HorizontalAlignment="Left"
                        Margin="5,0,0,0"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="ExploreButton_Click">
                    <Button.RenderTransform>
                        <TranslateTransform/>
                    </Button.RenderTransform>
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1B3A2A" Offset="0"/>
                            <GradientStop Color="#27894C" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="25">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>

                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="5" Height="5" Fill="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Explore the platform" VerticalAlignment="Center" FontSize="16" FontWeight="Medium"/>
                    </StackPanel>
                </Button>

            </StackPanel>

            <!-- Right Side: House Image -->

        </Grid>

    </Grid>

    <!-- Login / Register popup (hidden until Login or Sign Up is clicked) -->
    <Grid x:Name="AuthOverlay"
          Visibility="Collapsed"
          Background="#99000000"
          MouseLeftButtonDown="AuthOverlay_MouseLeftButtonDown">
        <!-- Step 1: "Are you a tenant or a landlord?" -->
        <local:UserTypeCard x:Name="UserType"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            NextClicked="UserType_NextClicked"
                            BackClicked="UserType_BackClicked"/>

        <!-- Step 2: Login / Register -->
        <local:AuthCard x:Name="Auth"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        LoginSucceeded="Auth_LoginSucceeded"
                        CloseRequested="Auth_CloseRequested"/>
    </Grid>

    </Grid>
</Window>
