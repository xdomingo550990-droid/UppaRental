<Window x:Class="RentalManagementSystem.Presentation.LandingPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Uppa - Rental Management System"
         Width="1440"
        Height="825"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="0,-9,0,-6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="77*"/>
            <ColumnDefinition Width="643*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="429*"/>
            <RowDefinition Height="470*"/>
        </Grid.RowDefinitions>
        <Grid.Background>
            <ImageBrush ImageSource="/Resources/Images/designLanding.png" Stretch="UniformToFill"/>
        </Grid.Background>

        <!-- Navigation Bar -->
        <Grid Height="80"
              VerticalAlignment="Top"
              Margin="60,9,60,0" Grid.ColumnSpan="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <!-- Logo -->
            <TextBlock Grid.Column="0"
                       Text="Uppa."
                       FontSize="34"
                       FontWeight="Bold"
                       Foreground="#1B3A2A"
                       VerticalAlignment="Top"
                       Margin="50,22,0,0"/>


            <!-- Navigation Links -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top" Margin="0,-1,0,0">

                <Button Content="Home"
                        Margin="20,0"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="#27894C"/>

                <Button Content="About"
                        Margin="24,0"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="#27894C"/>

                <Button Content="Contact"
                        Margin="24,0"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="#27894C"/>

                <Button Content="Blog"
                        Margin="20,0"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="21"
                        FontWeight="SemiBold"
                        Foreground="#27894C"/>

            </StackPanel>

            <!-- Login / Sign Up -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,2,0,0">

                <Button Content="Login"
                        Margin="10,0"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="#27894C"
                        Click="LoginButton_Click"/>

                <Button Content="Sign Up"
                        Margin="10,0"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="20"
                        FontWeight="SemiBold"/>

            </StackPanel>
            <Image Margin="0,25,205,10" Source="/Resources/Icons/houseLogo.png" Stretch="Fill"/>
        </Grid>


        <!-- Hero Section -->
        <Grid Margin="60,58,497,166" RenderTransformOrigin="0.944,0.476" Grid.RowSpan="2" Grid.ColumnSpan="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="45*"/>
                <ColumnDefinition Width="55*"/>
            </Grid.ColumnDefinitions>


            <!-- Left Side: Text -->
            <StackPanel Grid.Column="0"
                        VerticalAlignment="Top"
                        Margin="10,148,50,0">


                <!-- Main Heading -->
                <TextBlock FontSize="63" 
           FontWeight="Bold" 
           Foreground="#1B3A2A" 
           LineHeight="55"
           LineStackingStrategy="BlockLineHeight">
    <Run Text="Ready to"/>
    <LineBreak/>
    <Run Text="Find Your"/>
    <LineBreak/>
    <Run Text="Dream" Foreground="#9C8159" FontStyle="Italic"/>
    <LineBreak/>
    <Run Text="Property?"/>
                </TextBlock>
                <!-- Subtext -->
                <TextBlock Text="Everything in one place." 
                           FontSize="18" 
                           Foreground="#333333" 
                           Margin="5,25,0,30"/>

                <!-- Explore Button -->
                <Button Width="220" 
                        Height="50" 
                        Background="Black" 
                        Foreground="White" 
                        HorizontalAlignment="Left" 
                        Margin="5,0,0,0"
                        BorderThickness="0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="5" Height="5" Fill="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Explore the platform" VerticalAlignment="Center" FontSize="16" FontWeight="Medium"/>
                    </StackPanel>
                </Button>

            </StackPanel>

            <!-- Right Side: House Image -->

        </Grid>

    </Grid>
</Window>