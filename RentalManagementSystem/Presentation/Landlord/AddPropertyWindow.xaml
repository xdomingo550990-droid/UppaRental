<Window x:Class="RentalManagementSystem.Presentation.AddPropertyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RentalManagementSystem.Presentation"
        Title="Add New Property / Unit"
        Width="780" Height="760"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- Field label -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#5C7060"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Rounded input box (wraps a PlainTextBox) -->
        <Style x:Key="InputBorder" TargetType="Border">
            <Setter Property="Background" Value="#F7F9F7"/>
            <Setter Property="BorderBrush" Value="#E0E6E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Height" Value="40"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#1E3223"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PlainTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1E3223"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NotesTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1E3223"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dropdowns and checkboxes -->
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1E3223"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Status pill (border color = text color when selected) -->
        <Style x:Key="StatusPill" TargetType="RadioButton">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="pill" Background="{TemplateBinding Background}" CornerRadius="12"
                                Padding="18,8" BorderThickness="2" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="pill" Property="BorderBrush" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- sq ft / sqm toggle -->
        <Style x:Key="UnitToggle" TargetType="RadioButton">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#5C7060"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="seg" Background="Transparent" CornerRadius="8" Padding="14,0" Height="32">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="seg" Property="Background" Value="#1E3223"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Amenity chip (multi-select) -->
        <Style x:Key="FeatureChip" TargetType="ToggleButton">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1E3223"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="chip" Background="#F0F4F1" BorderBrush="#DDE5DF" BorderThickness="1"
                                CornerRadius="18" Padding="16,9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chip" Property="Background" Value="#E3EAE5"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="chip" Property="Background" Value="#1E3223"/>
                                <Setter TargetName="chip" Property="BorderBrush" Value="#1E3223"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Footer buttons -->
        <Style x:Key="FooterButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="22,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CancelButton" TargetType="Button" BasedOn="{StaticResource FooterButton}">
            <Setter Property="Background" Value="#EEF1EF"/>
            <Setter Property="Foreground" Value="#5C7060"/>
            <Setter Property="BorderBrush" Value="#DDE5DF"/>
        </Style>
        <Style x:Key="DraftButton" TargetType="Button" BasedOn="{StaticResource FooterButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#1E3223"/>
            <Setter Property="BorderBrush" Value="#1E3223"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource FooterButton}">
            <Setter Property="Background" Value="#1E3223"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#1E3223"/>
        </Style>

        <!-- Close (X) -->
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="#5C7060"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="17" Background="Transparent">
                            <TextBlock Text="✕" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EEF1EF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="20" Background="White" CornerRadius="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.35" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. HEADER -->
            <Grid Grid.Row="0" Margin="28,22,18,0" Background="Transparent"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Add New Property / Unit" FontSize="22" FontWeight="Bold" Foreground="#1E3223"/>
                    <TextBlock x:Name="StepSubtitle" Text="Step 1 of 3 · Basic Info"
                               FontSize="12" Foreground="#607464" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Style="{StaticResource CloseButton}"
                        VerticalAlignment="Top" Click="Cancel_Click"/>
            </Grid>

            <!-- STEP INDICATOR -->
            <Grid Grid.Row="1" Margin="28,20,28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border x:Name="Dot1" Width="28" Height="28" CornerRadius="14" Background="#1E3223">
                        <TextBlock x:Name="Num1" Text="1" Foreground="White" FontWeight="Bold" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="Label1" Text="Basic Info" FontWeight="SemiBold" FontSize="13"
                               Foreground="#1E3223" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <Border x:Name="Line1" Grid.Column="1" Height="2" Background="#DDE5DF" Margin="14,0" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Border x:Name="Dot2" Width="28" Height="28" CornerRadius="14" Background="#E3EAE5">
                        <TextBlock x:Name="Num2" Text="2" Foreground="#7C8F80" FontWeight="Bold" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="Label2" Text="Financials" FontWeight="SemiBold" FontSize="13"
                               Foreground="#8A9A8D" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <Border x:Name="Line2" Grid.Column="3" Height="2" Background="#DDE5DF" Margin="14,0" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Border x:Name="Dot3" Width="28" Height="28" CornerRadius="14" Background="#E3EAE5">
                        <TextBlock x:Name="Num3" Text="3" Foreground="#7C8F80" FontWeight="Bold" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="Label3" Text="Amenities &amp; Photos" FontWeight="SemiBold" FontSize="13"
                               Foreground="#8A9A8D" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>

            <!-- STEP CONTENT -->
            <ScrollViewer x:Name="ContentScroll" Grid.Row="2" Margin="28,22,28,0"
                          VerticalScrollBarVisibility="Auto">
                <Grid>

                    <!-- STEP 1: BASIC INFORMATION -->
                    <Grid x:Name="Step1Panel">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: Name | Property Type -->
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Property / Unit Name or Number" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource InputBorder}">
                                <TextBox x:Name="txtName" Style="{StaticResource PlainTextBox}"/>
                            </Border>
                            <TextBlock Text="e.g., Unit 101 or Suite 4B" FontSize="11" Foreground="#8A9A8D" Margin="2,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="Property Type" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cmbRoomType">
                                <ComboBoxItem Content="Studio"/>
                                <ComboBoxItem Content="Guesthouse"/>
                                <ComboBoxItem Content="Cabin"/>
                                <ComboBoxItem Content="Townhouse"/>
                                <ComboBoxItem Content="Commercial"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Row 1: Location | Unit Size / Area -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,18,0,0">
                            <TextBlock Text="Location" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource InputBorder}">
                                <TextBox x:Name="txtLocation" Style="{StaticResource PlainTextBox}"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,18,0,0">
                            <TextBlock Text="Unit Size / Area" Style="{StaticResource FieldLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource InputBorder}">
                                    <TextBox x:Name="txtSize" Style="{StaticResource PlainTextBox}"/>
                                </Border>
                                <Border Grid.Column="1" Background="#F0F4F1" CornerRadius="10" Padding="4" Margin="8,0,0,0" Height="40">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="rbSqft" Content="sq ft" GroupName="SizeUnit" IsChecked="True"
                                                     Style="{StaticResource UnitToggle}"/>
                                        <RadioButton x:Name="rbSqm" Content="sqm" GroupName="SizeUnit"
                                                     Style="{StaticResource UnitToggle}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!-- Row 2: Number of Floors | Maximum Capacity -->
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,18,0,0">
                            <TextBlock Text="Number of Floors *" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource InputBorder}">
                                <TextBox x:Name="txtFloors" Style="{StaticResource PlainTextBox}"
                                         PreviewTextInput="NumberOnly_PreviewTextInput"
                                         DataObject.Pasting="NumberOnly_Pasting" MaxLength="3"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,18,0,0">
                            <TextBlock Text="Maximum Capacity (persons)" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource InputBorder}">
                                <TextBox x:Name="txtCapacity" Style="{StaticResource PlainTextBox}" Text="2"
                                         PreviewTextInput="NumberOnly_PreviewTextInput"
                                         DataObject.Pasting="NumberOnly_Pasting" MaxLength="3"/>
                            </Border>
                            <TextBlock Text="Most people allowed to stay in this unit" FontSize="11"
                                       Foreground="#8A9A8D" Margin="2,4,0,0"/>
                        </StackPanel>

                        <!-- Row 3: Bedrooms | Bathrooms -->
                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,18,0,0">
                            <TextBlock Text="Number of Bedrooms *" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource InputBorder}">
                                <TextBox x:Name="txtBedrooms" Style="{StaticResource PlainTextBox}"
                                         PreviewTextInput="NumberOnly_PreviewTextInput"
                                         DataObject.Pasting="NumberOnly_Pasting" MaxLength="3"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,18,0,0">
                            <TextBlock Text="Number of Bathrooms *" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource InputBorder}">
                                <TextBox x:Name="txtBathrooms" Style="{StaticResource PlainTextBox}"
                                         PreviewTextInput="NumberOnly_PreviewTextInput"
                                         DataObject.Pasting="NumberOnly_Pasting" MaxLength="3"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- STEP 2: PRICING & FINANCIAL DETAILS -->
                    <Grid x:Name="Step2Panel" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Daily Rent Amount" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource InputBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="₱" FontWeight="Bold" Foreground="#607464" FontSize="14"
                                               VerticalAlignment="Center" Margin="14,0,0,0"/>
                                    <TextBox x:Name="txtRent" Grid.Column="1" Style="{StaticResource PlainTextBox}" Padding="8,0,12,0"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="Security Deposit" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource InputBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="₱" FontWeight="Bold" Foreground="#607464" FontSize="14"
                                               VerticalAlignment="Center" Margin="14,0,0,0"/>
                                    <TextBox x:Name="txtDeposit" Grid.Column="1" Style="{StaticResource PlainTextBox}" Padding="8,0,12,0"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,24,0,0">
                            <TextBlock Text="Utility Billing Setup" Style="{StaticResource FieldLabel}"/>
                            <Border Background="#F7F9F7" BorderBrush="#E0E6E1" BorderThickness="1" CornerRadius="12" Padding="18,16,18,16">
                                <StackPanel>
                                    <!-- Water -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="chkWater" Content="Water — ₱" IsChecked="True" VerticalAlignment="Center" Margin="0"/>
                                        <Border Grid.Column="1" Style="{StaticResource InputBorder}" Height="34" Margin="6,0,8,0">
                                            <TextBox x:Name="txtWaterRate" Style="{StaticResource PlainTextBox}" Text="100" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="per property" VerticalAlignment="Center" Foreground="#1E3223" FontSize="13"/>
                                    </Grid>

                                    <!-- Electricity -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="chkElectricity" Content="Electricity — ₱" IsChecked="True" VerticalAlignment="Center" Margin="0"/>
                                        <Border Grid.Column="1" Style="{StaticResource InputBorder}" Height="34" Margin="6,0,8,0">
                                            <TextBox x:Name="txtElectricityRate" Style="{StaticResource PlainTextBox}" Text="15" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="per kWh per property" VerticalAlignment="Center" Foreground="#1E3223" FontSize="13"/>
                                    </Grid>

                                    <!-- Wi-Fi -->
                                    <Grid Margin="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="chkWifi" Content="Wi-Fi — ₱" IsChecked="True" VerticalAlignment="Center" Margin="0"/>
                                        <Border Grid.Column="1" Style="{StaticResource InputBorder}" Height="34" Margin="6,0,8,0">
                                            <TextBox x:Name="txtWifiRate" Style="{StaticResource PlainTextBox}" Text="99" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="per property" VerticalAlignment="Center" Foreground="#1E3223" FontSize="13"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- STEP 3: AMENITIES, MEDIA & NOTES -->
                    <StackPanel x:Name="Step3Panel" Visibility="Collapsed">
                        <TextBlock Text="Amenities &amp; Unit Features" Style="{StaticResource FieldLabel}"/>
                        <WrapPanel Margin="0,0,0,8">
                            <ToggleButton x:Name="tbAircon" Content="Air Conditioning" Style="{StaticResource FeatureChip}"/>
                            <ToggleButton x:Name="tbFurnished" Content="Fully Furnished" Style="{StaticResource FeatureChip}"/>
                            <ToggleButton x:Name="tbBalcony" Content="Balcony" Style="{StaticResource FeatureChip}"/>
                            <ToggleButton x:Name="tbPets" Content="Pet Friendly" Style="{StaticResource FeatureChip}"/>
                            <ToggleButton x:Name="tbParking" Content="Parking Space Included" Style="{StaticResource FeatureChip}"/>
                        </WrapPanel>

                        <TextBlock Text="Photos" Style="{StaticResource FieldLabel}" Margin="0,8,0,6"/>
                        <Grid x:Name="DropZone" Height="120" Background="Transparent" AllowDrop="True" Cursor="Hand"
                              MouseLeftButtonUp="DropZone_Click" DragOver="DropZone_DragOver" Drop="DropZone_Drop">
                            <Rectangle RadiusX="14" RadiusY="14" Stroke="#9DB5A2" StrokeThickness="1.5"
                                       StrokeDashArray="4 3" Fill="#F7F9F7"/>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                           Foreground="#607464" HorizontalAlignment="Center"/>
                                <TextBlock Text="Drag &amp; drop photos here, or click to browse" FontSize="13"
                                           FontWeight="SemiBold" Foreground="#1E3223" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                                <TextBlock Text="JPG or PNG · unit thumbnails and interior photos" FontSize="11"
                                           Foreground="#607464" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="PhotoCountText" FontSize="11" Foreground="#27894C" Margin="2,6,0,0"
                                   TextWrapping="Wrap" Visibility="Collapsed"/>

                        <TextBlock Text="Notes / Internal Description" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
                        <Border Style="{StaticResource InputBorder}" Height="96">
                            <TextBox x:Name="txtNotes" Style="{StaticResource NotesTextBox}"/>
                        </Border>
                        <TextBlock Text="Landlord notes only, e.g., maintenance reminders or past tenant notes."
                                   FontSize="11" Foreground="#8A9A8D" Margin="2,4,0,12"/>
                    </StackPanel>

                </Grid>
            </ScrollViewer>

            <!-- ERROR MESSAGE -->
            <TextBlock x:Name="ErrorText" Grid.Row="3" Margin="28,10,28,0" FontSize="12" FontWeight="SemiBold"
                       Foreground="#C84B41" TextWrapping="Wrap" Visibility="Collapsed"/>

            <!-- FOOTER BUTTONS -->
            <Grid Grid.Row="4" Margin="28,16,28,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Cancel" Style="{StaticResource CancelButton}" Click="Cancel_Click"/>
                <Button x:Name="btnBack" Grid.Column="1" Content="← Back" Style="{StaticResource CancelButton}"
                        Margin="10,0,0,0" Visibility="Collapsed" Click="Back_Click"/>
                <Button Grid.Column="3" Content="Save as Draft" Style="{StaticResource DraftButton}"
                        Margin="0,0,10,0" Click="SaveDraft_Click"/>
                <Button x:Name="btnPrimary" Grid.Column="4" Content="Next →" Style="{StaticResource PrimaryButton}"
                        Click="Primary_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>