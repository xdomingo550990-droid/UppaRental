<UserControl x:Class="RentalManagementSystem.Presentation.BillingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/PageStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ============ Form panel styles ============ -->
            <Style x:Key="PanelCaption" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#D9B45A"/>
                <Setter Property="FontSize" Value="10.5"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Margin" Value="1,0,0,10"/>
            </Style>

            <Style x:Key="FormLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#CFE0D3"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="Margin" Value="1,0,0,4"/>
            </Style>

            <!-- Slim off-white text input, 6px corners -->
            <Style x:Key="FormInput" TargetType="TextBox">
                <Setter Property="Height" Value="28"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Foreground" Value="#1C3527"/>
                <Setter Property="Background" Value="#F4F6F4"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="Transparent"
                                    BorderThickness="1.5" CornerRadius="6">
                                <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#D9B45A"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Rounded wrapper for dropdowns and the date picker -->
            <Style x:Key="FormBox" TargetType="Border">
                <Setter Property="Height" Value="28"/>
                <Setter Property="Background" Value="#F4F6F4"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="ClipToBounds" Value="True"/>
            </Style>

            <Style TargetType="ComboBoxItem">
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="Foreground" Value="#1C3527"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="bd" CornerRadius="6" Padding="{TemplateBinding Padding}" Background="Transparent">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#EEF2EE"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#DCEBDF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="FormCombo" TargetType="ComboBox">
                <Setter Property="Height" Value="28"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Foreground" Value="#1C3527"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton Focusable="False" ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent">
                                                <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                                                      Data="M0,0 L4,4 L8,0" Stroke="#5B6B60" StrokeThickness="1.6"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter IsHitTestVisible="False" Margin="10,0,30,0" VerticalAlignment="Center"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                                <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                       AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                    <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                            Background="White" BorderBrush="#D5DDD7" BorderThickness="1"
                                            CornerRadius="8" Padding="4" Margin="0,6,0,16">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.15"/>
                                        </Border.Effect>
                                        <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Date picker without the white patch -->
            <Style TargetType="DatePickerTextBox">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DatePickerTextBox">
                            <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" VerticalAlignment="Center"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="DatePicker">
                <Setter Property="Height" Value="26"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="8,0,4,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="#1C3527"/>
            </Style>

            <!-- Slim action buttons -->
            <Style x:Key="FormButton" TargetType="Button">
                <Setter Property="Height" Value="30"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" Padding="12,0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="FormButtonSave" TargetType="Button" BasedOn="{StaticResource FormButton}">
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="White"/>
                <Setter Property="Foreground" Value="#1C3527"/>
            </Style>
            <Style x:Key="FormButtonClear" TargetType="Button" BasedOn="{StaticResource FormButton}">
                <Setter Property="Background" Value="#26FFFFFF"/>
                <Setter Property="BorderBrush" Value="#4DFFFFFF"/>
                <Setter Property="Foreground" Value="White"/>
            </Style>
            <Style x:Key="FormButtonDelete" TargetType="Button" BasedOn="{StaticResource FormButton}">
                <Setter Property="Background" Value="#B94A48"/>
                <Setter Property="BorderBrush" Value="#B94A48"/>
                <Setter Property="Foreground" Value="White"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 1. Header -->
            <RowDefinition Height="Auto"/> <!-- 2. Invoice form panel -->
            <RowDefinition Height="*"/>    <!-- 3. Table card (Filters + DataGrid) -->
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <TextBlock Grid.Row="0" Text="Track invoices, collected rent, and outstanding balances."
                   Style="{StaticResource PageSubtitle}" FontWeight="SemiBold" Foreground="#1E3223"
                   Margin="0,0,0,16"/>

        <!-- 2. Inline invoice form panel + divider -->
        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <Border CornerRadius="12" Padding="26,18,26,8">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1C3527" Offset="0"/>
                        <GradientStop Color="#24432F" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect Color="#1C3527" Direction="270" ShadowDepth="5" BlurRadius="22" Opacity="0.22"/>
                </Border.Effect>

                <StackPanel>
                    <!-- Panel title -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="4" Height="30" CornerRadius="2" Background="#D9B45A"
                                VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Invoice Details" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                            <TextBlock Text="Create a new invoice, or click a row in the table to update it."
                                       FontSize="11.5" Foreground="#A9C2B0" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="176"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT: tenant and billing -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="TENANT &amp; BILLING" Style="{StaticResource PanelCaption}"/>

                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="Renter Name" Style="{StaticResource FormLabel}"/>
                                <Border Style="{StaticResource FormBox}">
                                    <ComboBox x:Name="CmbRenter" Style="{StaticResource FormCombo}"
                                              SelectionChanged="CmbRenter_SelectionChanged">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Border>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="Category" Style="{StaticResource FormLabel}"/>
                                <Border Style="{StaticResource FormBox}">
                                    <ComboBox x:Name="CmbCategory" Style="{StaticResource FormCombo}">
                                        <ComboBoxItem Content="Monthly Rent" IsSelected="True"/>
                                        <ComboBoxItem Content="Water Bill"/>
                                        <ComboBoxItem Content="Electric Bill"/>
                                        <ComboBoxItem Content="Security Deposit"/>
                                        <ComboBoxItem Content="Penalty / Late Fee"/>
                                    </ComboBox>
                                </Border>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="Assigned Unit" Style="{StaticResource FormLabel}"/>
                                <TextBox x:Name="TxtUnit" Style="{StaticResource FormInput}"
                                         IsReadOnly="True" Background="#E1E8E2"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- divider -->
                        <Border Grid.Column="1" Width="1" Background="#26FFFFFF" HorizontalAlignment="Center"/>

                        <!-- MIDDLE: amount and dates -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="AMOUNT &amp; DATES" Style="{StaticResource PanelCaption}"/>

                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="Amount (&#x20B1;)" Style="{StaticResource FormLabel}"/>
                                <TextBox x:Name="TxtAmount" Style="{StaticResource FormInput}"/>
                            </StackPanel>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Billing Period" Style="{StaticResource FormLabel}"/>
                                    <TextBox x:Name="TxtPeriod" Style="{StaticResource FormInput}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Due Date" Style="{StaticResource FormLabel}"/>
                                    <Border Style="{StaticResource FormBox}">
                                        <DatePicker x:Name="DpDueDate"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="Payment Status" Style="{StaticResource FormLabel}"/>
                                <Border Style="{StaticResource FormBox}">
                                    <ComboBox x:Name="CmbStatus" Style="{StaticResource FormCombo}">
                                        <ComboBoxItem Content="Pending" IsSelected="True"/>
                                        <ComboBoxItem Content="Paid"/>
                                        <ComboBoxItem Content="Overdue"/>
                                    </ComboBox>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- divider -->
                        <Border Grid.Column="3" Width="1" Background="#26FFFFFF" HorizontalAlignment="Center"/>

                        <!-- RIGHT: actions -->
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="ACTIONS" Style="{StaticResource PanelCaption}"/>

                            <Button x:Name="BtnSave" Style="{StaticResource FormButtonSave}" Click="SaveInvoice_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               Foreground="#1F9D55" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SaveText" Text="Save Invoice" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource FormButtonClear}" Click="ClearFields_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE75C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Clear Fields" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource FormButtonDelete}" Click="DeleteInvoice_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Delete Invoice" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <TextBlock Text="Delete removes the invoice selected in the table."
                                       FontSize="11" Foreground="#A9C2B0" TextWrapping="Wrap" Margin="2,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Divider -->
            <Border Height="1" Background="#C5D4C9" Margin="0,16,0,0"/>
        </StackPanel>

        <!-- 3. Main Invoices Card (Filters + DataGrid) -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Filter Pills -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                    <RadioButton x:Name="RbAll" Content="All" Tag="All" IsChecked="True"
                                 Style="{StaticResource FilterPill}" Checked="Filter_Checked"/>
                    <RadioButton x:Name="RbPaid" Content="Paid" Tag="Paid"
                                 Style="{StaticResource FilterPill}" Checked="Filter_Checked"/>
                    <RadioButton x:Name="RbPendingFilter" Content="Pending" Tag="Pending"
                                 Style="{StaticResource FilterPill}" Checked="Filter_Checked"/>
                    <RadioButton x:Name="RbOverdue" Content="Overdue" Tag="Overdue"
                                 Style="{StaticResource FilterPill}" Checked="Filter_Checked"/>
                </StackPanel>

                <!-- Invoices Table -->
                <DataGrid Grid.Row="1" x:Name="DgInvoices" Style="{StaticResource AppDataGrid}"
                          SelectionChanged="DgInvoices_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="INVOICE #" Binding="{Binding InvoiceNo}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#27894C"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="RENTER" Binding="{Binding Renter}" Width="*"/>
                        <DataGridTextColumn Header="UNIT" Binding="{Binding Unit}" Width="100"/>
                        <DataGridTextColumn Header="PERIOD" Binding="{Binding Period}" Width="110"/>
                        <DataGridTextColumn Header="DUE DATE" Binding="{Binding DueDate}" Width="120"/>
                        <DataGridTextColumn Header="AMOUNT" Binding="{Binding AmountText}" Width="130">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="STATUS" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource StatusBadge}">
                                        <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="Bold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="ACTIONS" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="View" Style="{StaticResource LinkButton}" Click="View_Click"/>
                                        <Button Content="Mark Paid" Click="MarkPaid_Click">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Paid">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>