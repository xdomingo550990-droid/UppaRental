<Window x:Class="RentalManagementSystem.Presentation.EditPropertyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RentalManagementSystem.Presentation"
        Title="Edit Property" Width="600" Height="780" MinHeight="520" MinWidth="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F4F7F4">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/PageStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Amenity Chip Style -->
            <Style x:Key="FeatureChip" TargetType="ToggleButton">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#1E3223"/>
                <Setter Property="Margin" Value="0,0,10,10"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="chip" Background="#F0F4F1" BorderBrush="#DDE5DF" BorderThickness="1"
                                    CornerRadius="18" Padding="16,9">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="chip" Property="Background" Value="#E3EAE5"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="chip" Property="Background" Value="#1E3223"/>
                                    <Setter TargetName="chip" Property="BorderBrush" Value="#1E3223"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Edit Property" Style="{StaticResource PageTitle}"/>
            <TextBlock x:Name="txtSubtitle" Text="Update the details, then save." Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource Card}" Margin="0,0,8,8" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Row 0: Property Name -->
                        <RowDefinition Height="Auto"/>
                        <!-- Row 1: Location | Floors -->
                        <RowDefinition Height="Auto"/>
                        <!-- Row 2: Type | Daily Rent -->
                        <RowDefinition Height="Auto"/>
                        <!-- Row 3: Bedrooms | Bathrooms -->
                        <RowDefinition Height="Auto"/>
                        <!-- Row 4: Size | Max Capacity -->
                        <RowDefinition Height="Auto"/>
                        <!-- Row 5: Status -->
                        <RowDefinition Height="Auto"/>
                        <!-- Row 6: Utility Billing Setup -->
                        <RowDefinition Height="Auto"/>
                        <!-- Row 7: Amenities & Unit Features -->
                        <RowDefinition Height="Auto"/>
                        <!-- Row 8: Description -->
                        <RowDefinition Height="Auto"/>
                        <!-- Row 9: Photo Path -->
                    </Grid.RowDefinitions>

                    <!-- Row 0: Property Name -->
                    <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,14">
                        <TextBlock Text="Property / Unit Name or Number" Style="{StaticResource FieldLabel}"/>
                        <Border Style="{StaticResource InputBorder}">
                            <TextBox x:Name="txtName" Style="{StaticResource PlainTextBox}"/>
                        </Border>
                    </StackPanel>

                    <!-- Row 1: Location | Number of Floors -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,14">
                        <TextBlock Text="Location" Style="{StaticResource FieldLabel}"/>
                        <Border Style="{StaticResource InputBorder}">
                            <TextBox x:Name="txtLocation" Style="{StaticResource PlainTextBox}"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,14">
                        <TextBlock Text="Number of Floors *" Style="{StaticResource FieldLabel}"/>
                        <Border Style="{StaticResource InputBorder}">
                            <TextBox x:Name="txtFloors" Style="{StaticResource PlainTextBox}"
                                     PreviewTextInput="NumberOnly_PreviewTextInput" DataObject.Pasting="NumberOnly_Pasting" MaxLength="3"/>
                        </Border>
                    </StackPanel>

                    <!-- Row 2: Property Type | Daily Rent Amount (Price) -->
                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,14">
                        <TextBlock Text="Property Type" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="cmbType">
                            <ComboBoxItem Content="Studio"/>
                            <ComboBoxItem Content="Guesthouse"/>
                            <ComboBoxItem Content="Cabin"/>
                            <ComboBoxItem Content="Townhouse"/>
                            <ComboBoxItem Content="Commercial"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,14">
                        <TextBlock Text="Daily Rent Amount (₱)" Style="{StaticResource FieldLabel}"/>
                        <Border Style="{StaticResource InputBorder}">
                            <TextBox x:Name="txtPrice" Style="{StaticResource PlainTextBox}"/>
                        </Border>
                    </StackPanel>

                    <!-- Row 3: Bedrooms | Bathrooms -->
                    <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,14">
                        <TextBlock Text="Number of Bedrooms *" Style="{StaticResource FieldLabel}"/>
                        <Border Style="{StaticResource InputBorder}">
                            <TextBox x:Name="txtBedrooms" Style="{StaticResource PlainTextBox}"
                                     PreviewTextInput="NumberOnly_PreviewTextInput" DataObject.Pasting="NumberOnly_Pasting" MaxLength="3"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,14">
                        <TextBlock Text="Number of Bathrooms *" Style="{StaticResource FieldLabel}"/>
                        <Border Style="{StaticResource InputBorder}">
                            <TextBox x:Name="txtBathrooms" Style="{StaticResource PlainTextBox}"
                                     PreviewTextInput="NumberOnly_PreviewTextInput" DataObject.Pasting="NumberOnly_Pasting" MaxLength="3"/>
                        </Border>
                    </StackPanel>

                    <!-- Row 4: Unit Size / Area | Maximum Capacity -->
                    <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,0,14">
                        <TextBlock Text="Unit Size / Area (sq ft)" Style="{StaticResource FieldLabel}"/>
                        <Border Style="{StaticResource InputBorder}">
                            <TextBox x:Name="txtSqFt" Style="{StaticResource PlainTextBox}"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,0,0,14">
                        <TextBlock Text="Maximum Capacity (persons)" Style="{StaticResource FieldLabel}"/>
                        <Border Style="{StaticResource InputBorder}">
                            <TextBox x:Name="txtCapacity" Style="{StaticResource PlainTextBox}"
                                     PreviewTextInput="NumberOnly_PreviewTextInput" DataObject.Pasting="NumberOnly_Pasting" MaxLength="3"/>
                        </Border>
                    </StackPanel>

                    <!-- Row 5: Status -->
                    <StackPanel Grid.Row="5" Grid.ColumnSpan="3" Margin="0,0,0,14">
                        <TextBlock Text="Status" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="cmbStatus" SelectedIndex="0">
                            <ComboBoxItem Content="Available"/>
                            <ComboBoxItem Content="Reserved"/>
                            <ComboBoxItem Content="Occupied"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Row 6: Utility Billing Setup -->
                    <StackPanel Grid.Row="6" Grid.ColumnSpan="3" Margin="0,0,0,14">
                        <TextBlock Text="Utility Billing Setup" Style="{StaticResource FieldLabel}"/>
                        <Border Background="#F7F9F7" BorderBrush="#E0E6E1" BorderThickness="1" CornerRadius="12" Padding="18,16,18,16">
                            <StackPanel>
                                <!-- Water -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="chkWater" Content="Water — ₱" VerticalAlignment="Center" Margin="0"/>
                                    <Border Grid.Column="1" Style="{StaticResource InputBorder}" Height="34" Margin="6,0,8,0">
                                        <TextBox x:Name="txtWaterRate" Style="{StaticResource PlainTextBox}" Text="100" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="per property" VerticalAlignment="Center" Foreground="#1E3223" FontSize="13"/>
                                </Grid>

                                <!-- Electricity -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="chkElectricity" Content="Electricity — ₱" VerticalAlignment="Center" Margin="0"/>
                                    <Border Grid.Column="1" Style="{StaticResource InputBorder}" Height="34" Margin="6,0,8,0">
                                        <TextBox x:Name="txtElectricityRate" Style="{StaticResource PlainTextBox}" Text="15" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="per kWh per property" VerticalAlignment="Center" Foreground="#1E3223" FontSize="13"/>
                                </Grid>

                                <!-- Wi-Fi -->
                                <Grid Margin="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="chkWifi" Content="Wi-Fi — ₱" VerticalAlignment="Center" Margin="0"/>
                                    <Border Grid.Column="1" Style="{StaticResource InputBorder}" Height="34" Margin="6,0,8,0">
                                        <TextBox x:Name="txtWifiRate" Style="{StaticResource PlainTextBox}" Text="99" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="per property" VerticalAlignment="Center" Foreground="#1E3223" FontSize="13"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Row 7: Amenities & Unit Features -->
                    <StackPanel Grid.Row="7" Grid.ColumnSpan="3" Margin="0,0,0,14">
                        <TextBlock Text="Amenities &amp; Unit Features" Style="{StaticResource FieldLabel}"/>
                        <WrapPanel Margin="0,4,0,0">
                            <ToggleButton x:Name="tbAircon" Content="Air Conditioning" Style="{StaticResource FeatureChip}"/>
                            <ToggleButton x:Name="tbFurnished" Content="Fully Furnished" Style="{StaticResource FeatureChip}"/>
                            <ToggleButton x:Name="tbBalcony" Content="Balcony" Style="{StaticResource FeatureChip}"/>
                            <ToggleButton x:Name="tbPets" Content="Pet Friendly" Style="{StaticResource FeatureChip}"/>
                            <ToggleButton x:Name="tbParking" Content="Parking Space Included" Style="{StaticResource FeatureChip}"/>
                        </WrapPanel>
                    </StackPanel>

                    <!-- Row 8: Description -->
                    <StackPanel Grid.Row="8" Grid.ColumnSpan="3" Margin="0,0,0,14">
                        <TextBlock Text="Description" Style="{StaticResource FieldLabel}"/>
                        <Border Style="{StaticResource InputBorder}" Height="90">
                            <TextBox x:Name="txtDescription" BorderThickness="0" Background="Transparent"
                                     Foreground="#1E3223" FontSize="13" Padding="10,8"
                                     TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                        </Border>
                    </StackPanel>

                    <!-- Row 9: Photo Path -->
                    <StackPanel Grid.Row="9" Grid.ColumnSpan="3">
                        <TextBlock Text="Photo (file path)" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource InputBorder}">
                                <TextBox x:Name="txtPhoto" Style="{StaticResource PlainTextBox}"/>
                            </Border>
                            <Button Grid.Column="1" Content="Browse…" Style="{StaticResource OutlineButton}"
                                    Margin="10,0,0,0" Click="Browse_Click"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="txtError" Foreground="#A81C0C" FontSize="12" TextWrapping="Wrap"
                       VerticalAlignment="Center" Margin="0,0,16,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Cancel" Style="{StaticResource OutlineButton}" IsCancel="True"
                        Margin="0,0,10,0" Click="Cancel_Click"/>
                <Button Content="Save changes" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>