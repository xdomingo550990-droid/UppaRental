<UserControl x:Class="RentalManagementSystem.Presentation.UtilityOptionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>
        <CheckBox x:Name="chkIncluded" Margin="0,0,0,10"
                  Checked="Included_Changed" Unchecked="Included_Changed"/>

        <Border x:Name="detailsPanel" Margin="26,0,0,14" Padding="14,12,14,14" Background="White"
                BorderBrush="#E0E6E1" BorderThickness="1" CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="Not included — bill tenant by" Style="{DynamicResource FieldLabel}"/>
                    <ComboBox x:Name="cmbBilling"/>
                </StackPanel>

                <StackPanel x:Name="amountPanel" Grid.Row="0" Grid.Column="2">
                    <TextBlock x:Name="lblAmount" Text="Amount" Style="{DynamicResource FieldLabel}"/>
                    <Border Style="{DynamicResource InputBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="₱" FontWeight="Bold" Foreground="#607464" FontSize="14"
                                       VerticalAlignment="Center" Margin="14,0,0,0"/>
                            <TextBox x:Name="txtAmount" Grid.Column="1" Style="{DynamicResource PlainTextBox}"
                                     Padding="8,0,12,0"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0">
                    <TextBlock Text="Customization note (optional)" Style="{DynamicResource FieldLabel}"/>
                    <Border Style="{DynamicResource InputBorder}">
                        <TextBox x:Name="txtNote" Style="{DynamicResource PlainTextBox}"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>