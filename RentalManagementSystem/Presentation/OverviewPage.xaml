<UserControl x:Class="RentalManagementSystem.Presentation.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">

    <Grid>
        <Grid.Resources>

            <!-- Category chip -->
            <Style x:Key="ChipStyle" TargetType="RadioButton">
                <Setter Property="GroupName" Value="Category"/>
                <Setter Property="Foreground" Value="#1E3223"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Margin" Value="0,0,10,10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="chip" Padding="20,9" CornerRadius="18" Background="White">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.12"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="chip" Property="Background" Value="#F1F5F2"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="chip" Property="Background" Value="#1E3223"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Section heading + divider -->
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="#1E3223"/>
            </Style>
            <Style x:Key="SectionSubtitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="#607464"/>
                <Setter Property="Margin" Value="0,3,0,16"/>
            </Style>
            <Style x:Key="SectionDivider" TargetType="Border">
                <Setter Property="Height" Value="1"/>
                <Setter Property="Margin" Value="0,8,0,24"/>
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00A9BDAD" Offset="0"/>
                            <GradientStop Color="#FFA9BDAD" Offset="0.5"/>
                            <GradientStop Color="#00A9BDAD" Offset="1"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Occupancy status badge on the photo -->
            <Style x:Key="StatusBadge" TargetType="Border">
                <Setter Property="Background" Value="#E8ECE9"/>
                <Setter Property="TextElement.Foreground" Value="#5C7060"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="10,3"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Status}" Value="Available">
                        <Setter Property="Background" Value="#D0F0C0"/>
                        <Setter Property="TextElement.Foreground" Value="#004225"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="Reserved">
                        <Setter Property="Background" Value="#FFF3C4"/>
                        <Setter Property="TextElement.Foreground" Value="#8C6B00"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="Occupied">
                        <Setter Property="Background" Value="#FFDCD8"/>
                        <Setter Property="TextElement.Foreground" Value="#A81C0C"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Detail row text and icons -->
            <Style x:Key="DetailText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="#5C7060"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="IconEmoji" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Emoji"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="#27894C"/>
                <Setter Property="Width" Value="20"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="IconMdl2" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="#27894C"/>
                <Setter Property="Width" Value="20"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- "Read more" link -->
            <Style x:Key="ReadMoreButton" TargetType="Button">
                <Setter Property="Foreground" Value="#27894C"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="#1E3223"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 4 cards per row -->
            <ItemsPanelTemplate x:Key="FourColumnPanel">
                <UniformGrid Columns="4"/>
            </ItemsPanelTemplate>

            <!-- One property card: photo, name, location, details, price -->
            <DataTemplate x:Key="PropertyCardTemplate">
                <Border Background="White" CornerRadius="16" Padding="12" Margin="0,0,16,16">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.10" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel>

                        <!-- Photo with status badge and heart -->
                        <Border Height="150" CornerRadius="12">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Photo}" Stretch="UniformToFill"/>
                            </Border.Background>
                            <Grid>
                                <Border Style="{StaticResource StatusBadge}"
                                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0">
                                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold"/>
                                </Border>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0"
                                        Width="28" Height="28" CornerRadius="14" Background="#CCFFFFFF">
                                    <TextBlock Text="♡" FontFamily="Segoe UI Symbol" FontSize="14" Foreground="#1E3223"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Name + location -->
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="#1E3223"
                                   Margin="2,12,0,0" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Margin="2,5,0,0">
                            <TextBlock Text="&#xE707;" Style="{StaticResource IconMdl2}" Foreground="#8A9A8D" Width="16"/>
                            <TextBlock Text="{Binding Location}" FontSize="11" Foreground="#8A9A8D"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Details: bedrooms, bathrooms, size, lease term -->
                        <Grid Margin="2,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="🛏" Style="{StaticResource IconEmoji}"/>
                                <TextBlock Text="{Binding BedroomsText}" Style="{StaticResource DetailText}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="🛁" Style="{StaticResource IconEmoji}"/>
                                <TextBlock Text="{Binding BathroomsText}" Style="{StaticResource DetailText}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="&#xE740;" Style="{StaticResource IconMdl2}"/>
                                <TextBlock Text="{Binding SqFtText}" Style="{StaticResource DetailText}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="&#xE787;" Style="{StaticResource IconMdl2}"/>
                                <TextBlock Text="{Binding Term}" Style="{StaticResource DetailText}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Price + Read more -->
                        <Border BorderBrush="#EAEFEB" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="2,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PriceText}" FontSize="16" FontWeight="Bold" Foreground="#1E3223"/>
                                    <TextBlock Text="{Binding PriceUnit}" FontSize="11" Foreground="#8A9A8D"
                                               VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Read more  ›" Style="{StaticResource ReadMoreButton}"
                                        VerticalAlignment="Center" Click="ReadMore_Click"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Heading -->
        <TextBlock Grid.Row="0" HorizontalAlignment="Center" Margin="0,8,0,20"
                   FontSize="30" FontWeight="Bold" Foreground="#1E3223">
            <Run Text="Ready to Find Your "/>
            <Run Text="Dream" FontFamily="Georgia" FontStyle="Italic" Foreground="#C9972B"/>
            <Run Text=" Property?"/>
        </TextBlock>

        <!-- Category chips: same categories as the sections below -->
        <WrapPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,14">
            <RadioButton Style="{StaticResource ChipStyle}" Content="All" Tag="All" IsChecked="True" Checked="Category_Checked"/>
            <RadioButton Style="{StaticResource ChipStyle}" Content="Most Popular" Tag="Popular" Checked="Category_Checked"/>
            <RadioButton Style="{StaticResource ChipStyle}" Content="Most Affordable" Tag="Affordable" Checked="Category_Checked"/>
            <RadioButton Style="{StaticResource ChipStyle}" Content="Available" Tag="Available" Checked="Category_Checked"/>
            <RadioButton Style="{StaticResource ChipStyle}" Content="Reserved" Tag="Reserved" Checked="Category_Checked"/>
            <RadioButton Style="{StaticResource ChipStyle}" Content="Occupied" Tag="Occupied" Checked="Category_Checked"/>
            <RadioButton Style="{StaticResource ChipStyle}" Content="Long Term" Tag="Long" Checked="Category_Checked"/>
            <RadioButton Style="{StaticResource ChipStyle}" Content="Short Term" Tag="Short" Checked="Category_Checked"/>
        </WrapPanel>

        <!-- Sections (scroll down) -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,16">

                <!-- 1. Most Popular -->
                <StackPanel x:Name="secPopular">
                    <Border Style="{StaticResource SectionDivider}"/>
                    <TextBlock Text="Most Popular" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Top picks ranked by renter inquiries" Style="{StaticResource SectionSubtitle}"/>
                    <ItemsControl x:Name="icPopular" ItemTemplate="{StaticResource PropertyCardTemplate}"
                                  ItemsPanel="{StaticResource FourColumnPanel}"/>
                </StackPanel>

                <!-- 2. Most Affordable -->
                <StackPanel x:Name="secAffordable">
                    <Border Style="{StaticResource SectionDivider}"/>
                    <TextBlock Text="Most Affordable" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Lowest monthly rent for long-term stays" Style="{StaticResource SectionSubtitle}"/>
                    <ItemsControl x:Name="icAffordable" ItemTemplate="{StaticResource PropertyCardTemplate}"
                                  ItemsPanel="{StaticResource FourColumnPanel}"/>
                </StackPanel>

                <!-- 3. Occupancy: Available -->
                <StackPanel x:Name="secAvailable">
                    <Border Style="{StaticResource SectionDivider}"/>
                    <TextBlock Text="Available Now" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Occupancy status: ready for move-in" Style="{StaticResource SectionSubtitle}"/>
                    <ItemsControl x:Name="icAvailable" ItemTemplate="{StaticResource PropertyCardTemplate}"
                                  ItemsPanel="{StaticResource FourColumnPanel}"/>
                </StackPanel>

                <!-- 4. Occupancy: Reserved -->
                <StackPanel x:Name="secReserved">
                    <Border Style="{StaticResource SectionDivider}"/>
                    <TextBlock Text="Reserved" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Occupancy status: booked, waiting for move-in" Style="{StaticResource SectionSubtitle}"/>
                    <ItemsControl x:Name="icReserved" ItemTemplate="{StaticResource PropertyCardTemplate}"
                                  ItemsPanel="{StaticResource FourColumnPanel}"/>
                </StackPanel>

                <!-- 5. Occupancy: Occupied -->
                <StackPanel x:Name="secOccupied">
                    <Border Style="{StaticResource SectionDivider}"/>
                    <TextBlock Text="Occupied" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Occupancy status: currently rented" Style="{StaticResource SectionSubtitle}"/>
                    <ItemsControl x:Name="icOccupied" ItemTemplate="{StaticResource PropertyCardTemplate}"
                                  ItemsPanel="{StaticResource FourColumnPanel}"/>
                </StackPanel>

                <!-- 6. Long term -->
                <StackPanel x:Name="secLong">
                    <Border Style="{StaticResource SectionDivider}"/>
                    <TextBlock Text="Long-Term Rentals" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Leases billed monthly" Style="{StaticResource SectionSubtitle}"/>
                    <ItemsControl x:Name="icLong" ItemTemplate="{StaticResource PropertyCardTemplate}"
                                  ItemsPanel="{StaticResource FourColumnPanel}"/>
                </StackPanel>

                <!-- 7. Short term -->
                <StackPanel x:Name="secShort">
                    <Border Style="{StaticResource SectionDivider}"/>
                    <TextBlock Text="Short-Term Stays" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Nightly bookings" Style="{StaticResource SectionSubtitle}"/>
                    <ItemsControl x:Name="icShort" ItemTemplate="{StaticResource PropertyCardTemplate}"
                                  ItemsPanel="{StaticResource FourColumnPanel}"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>