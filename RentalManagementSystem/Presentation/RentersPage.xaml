<UserControl x:Class="RentalManagementSystem.Presentation.RentersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/PageStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 1. Header -->
            <RowDefinition Height="Auto"/> <!-- 2. Summary cards -->
            <RowDefinition Height="*"/>    <!-- 3. Table card (Filters + DataGrid) -->
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Manage tenant profiles, lease periods, and rent status." 
                           Style="{StaticResource PageSubtitle}"
                           FontWeight="SemiBold"
                           Foreground="#1E3223"/>
            </StackPanel>
            
            <Button Grid.Column="1" Content="+ Add Renter" Style="{StaticResource PrimaryButton}"
                    VerticalAlignment="Center" Click="AddRenter_Click"/>
        </Grid>

        <!-- 2. Summary cards -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Background="#1E3223" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="Total renters" Style="{StaticResource StatLabel}" Foreground="#C9D8CC"/>
                    <TextBlock x:Name="txtTotal" Text="0" Style="{StaticResource StatValue}" Foreground="White"/>
                    <TextBlock Text="All tenants on record" Style="{StaticResource StatNote}" Foreground="#C9D8CC"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="Active leases" Style="{StaticResource StatLabel}"/>
                    <TextBlock x:Name="txtActive" Text="0" Style="{StaticResource StatValue}"/>
                    <TextBlock Text="Currently renting" Style="{StaticResource StatNote}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="Pending move-ins" Style="{StaticResource StatLabel}"/>
                    <TextBlock x:Name="txtPending" Text="0" Style="{StaticResource StatValue}"/>
                    <TextBlock Text="Waiting to start a lease" Style="{StaticResource StatNote}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. Main Renters Card (Filters + DataGrid) -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Filter Pills -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                    <RadioButton x:Name="rbAll" Content="All" Tag="All" IsChecked="True"
                                 Style="{StaticResource FilterPill}" Checked="Filter_Checked"/>
                    <RadioButton x:Name="rbActive" Content="Active" Tag="Active"
                                 Style="{StaticResource FilterPill}" Checked="Filter_Checked"/>
                    <RadioButton x:Name="rbPending" Content="Pending" Tag="Pending"
                                 Style="{StaticResource FilterPill}" Checked="Filter_Checked"/>
                    <RadioButton x:Name="rbPast" Content="Past" Tag="Past"
                                 Style="{StaticResource FilterPill}" Checked="Filter_Checked"/>
                </StackPanel>

                <!-- Renters Table -->
                <DataGrid Grid.Row="1" x:Name="dgRenters" Style="{StaticResource AppDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="RENTER" Width="230">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="32" Height="32" CornerRadius="16" Background="#1E3223">
                                            <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="Bold" FontSize="13"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="UNIT" Binding="{Binding Unit}" Width="100"/>
                        <DataGridTextColumn Header="CONTACT" Binding="{Binding Contact}" Width="150"/>
                        <DataGridTextColumn Header="LEASE PERIOD" Binding="{Binding LeasePeriod}" Width="*"/>
                        <DataGridTextColumn Header="MONTHLY RENT" Binding="{Binding RentText}" Width="130"/>
                        <DataGridTemplateColumn Header="STATUS" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource StatusBadge}">
                                        <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="Bold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="ACTIONS" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="View" Style="{StaticResource LinkButton}" Click="View_Click"/>
                                        <Button Content="Edit" Style="{StaticResource LinkButton}" Click="Edit_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>