<UserControl x:Class="RentalManagementSystem.Presentation.ReportsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
             TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
             Background="#F4F5F7">

    <UserControl.Resources>
        <!-- Palette: change these to re-theme the whole screen -->
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="FieldBg" Color="#F6F7F9"/>
        <SolidColorBrush x:Key="Accent" Color="#12874F"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#E6F4EC"/>
        <SolidColorBrush x:Key="Ink" Color="#111827"/>
        <SolidColorBrush x:Key="Muted" Color="#6B7280"/>
        <SolidColorBrush x:Key="Line" Color="#E6E8EC"/>

        <!-- Soft rounded card -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="#ECEEF1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="TextElement.Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.06" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded wrapper for inputs -->
        <Style x:Key="Field" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource FieldBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Margin" Value="4,0,0,6"/>
        </Style>

        <!-- Rounded dropdown items -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" CornerRadius="8" Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoft}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Borderless ComboBox with soft popup (sits inside a Field border) -->
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"
                                                  Data="M0,0 L4,4 L8,0" Stroke="{StaticResource Muted}" StrokeThickness="1.6"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Margin="14,0,34,0" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                        CornerRadius="14" Padding="4" Margin="0,6,0,16">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.12"/>
                                    </Border.Effect>
                                    <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </Style>

        <!-- Pill buttons -->
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="21" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- KPI text -->
        <Style x:Key="KpiTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        </Style>
        <Style x:Key="KpiValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,8,0,2"/>
        </Style>
        <Style x:Key="KpiCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        </Style>
        <Style x:Key="IconBadge" TargetType="Border">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- DataGrid with rounded rows -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserResizeColumns" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="RowHeight" Value="52"/>
            <Setter Property="ColumnHeaderHeight" Value="38"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="HeaderRight" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border Background="{TemplateBinding Background}" CornerRadius="14" SnapsToDevicePixels="True">
                            <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}"
                                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F6F7F9"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentSoft}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="Transparent" Padding="14,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IdText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
        </Style>
        <Style x:Key="AmountText" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        

        <!-- 1. Top bar / filters -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="22,16,22,20" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Report type"/>
                    <Border Style="{StaticResource Field}">
                        <ComboBox SelectedIndex="0">
                            <ComboBoxItem Content="Rental Report"/>
                            <ComboBoxItem Content="Payment Report"/>
                            <ComboBoxItem Content="Occupancy / Unit Status"/>
                        </ComboBox>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,14,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Start date"/>
                    <Border Style="{StaticResource Field}">
                        <DatePicker x:Name="StartPicker"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,14,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="End date"/>
                    <Border Style="{StaticResource Field}">
                        <DatePicker x:Name="EndPicker"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,14,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Room type"/>
                    <Border Style="{StaticResource Field}">
                        <ComboBox SelectedIndex="0">
                            <ComboBoxItem Content="All"/>
                            <ComboBoxItem Content="Standard"/>
                            <ComboBoxItem Content="Deluxe"/>
                            <ComboBoxItem Content="Suite"/>
                            <ComboBoxItem Content="Studio"/>
                        </ComboBox>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="4" Margin="0,0,14,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Payment status"/>
                    <Border Style="{StaticResource Field}">
                        <ComboBox SelectedIndex="0">
                            <ComboBoxItem Content="All"/>
                            <ComboBoxItem Content="Paid"/>
                            <ComboBoxItem Content="Pending"/>
                            <ComboBoxItem Content="Overdue"/>
                        </ComboBox>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource PrimaryButton}" Content="Generate report"/>
                    <Button Style="{StaticResource PillButton}" Content="Export to PDF"/>
                    <Button Style="{StaticResource PillButton}" Content="Export to Excel/CSV"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. KPI cards -->
        <Grid Grid.Row="2" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Total Revenue (highlight card) -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0"
                    BorderBrush="Transparent" TextElement.Foreground="White">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1AA566" Offset="0"/>
                        <GradientStop Color="#0E7A45" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource KpiTitle}" Text="Total revenue" Foreground="#D4F0E1"/>
                        <TextBlock Style="{StaticResource KpiValue}" Text="₱ 125,000.00"/>
                        <TextBlock Style="{StaticResource KpiCaption}" Text="Paid records in range" Foreground="#D4F0E1"/>
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource IconBadge}" Background="#33FFFFFF">
                        <TextBlock Style="{StaticResource Glyph}" FontFamily="Segoe UI" FontWeight="Bold" Foreground="White" Text="₱"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Outstanding Balance -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,16,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource KpiTitle}" Text="Outstanding balance"/>
                        <TextBlock Style="{StaticResource KpiValue}" Text="₱ 38,500.00"/>
                        <TextBlock Style="{StaticResource KpiCaption}" Text="Pending and overdue"/>
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource IconBadge}" Background="#FEF3C7">
                        <TextBlock Style="{StaticResource Glyph}" Foreground="#B45309" Text="&#xE7BA;"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Occupancy Rate -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,16,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource KpiTitle}" Text="Occupancy rate"/>
                        <TextBlock Style="{StaticResource KpiValue}" Text="78.5%"/>
                        <TextBlock Style="{StaticResource KpiCaption}" Text="Occupied rooms vs. capacity"/>
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource IconBadge}" Background="#E0EDFF">
                        <TextBlock Style="{StaticResource Glyph}" Foreground="#2563EB" Text="&#xE80F;"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Active Reservations -->
            <Border Grid.Column="3" Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource KpiTitle}" Text="Active reservations"/>
                        <TextBlock Style="{StaticResource KpiValue}" Text="24"/>
                        <TextBlock Style="{StaticResource KpiCaption}" Text="Currently booked"/>
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource IconBadge}" Background="#EDE9FE">
                        <TextBlock Style="{StaticResource Glyph}" Foreground="#7C3AED" Text="&#xE787;"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. Data area: table + pie chart -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="310"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12,12,12,8" Margin="0,0,20,0">
                <DataGrid x:Name="ReportsGrid">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Report ID" Binding="{Binding ReportId}"
                                            ElementStyle="{StaticResource IdText}" Width="1.1*"/>
                        <DataGridTextColumn Header="Date Generated"
                                            Binding="{Binding DateGenerated, StringFormat='MMM dd, yyyy', ConverterCulture=en-US}"
                                            Width="1.2*"/>
                        <DataGridTextColumn Header="Report Type" Binding="{Binding ReportType}" Width="1.6*"/>
                        <DataGridTextColumn Header="Tenant/Reference" Binding="{Binding Reference}" Width="2*"/>
                        <DataGridTextColumn Header="Amount"
                                            Binding="{Binding Amount, StringFormat='₱ {0:N2}', ConverterCulture=en-US}"
                                            HeaderStyle="{StaticResource HeaderRight}"
                                            ElementStyle="{StaticResource AmountText}" Width="1.2*"/>
                        <DataGridTemplateColumn Header="Status" Width="1*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12" Padding="12,4" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FEF3C7"/>
                                                <Setter Property="TextElement.Foreground" Value="#92400E"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Paid">
                                                        <Setter Property="Background" Value="#E6F4EC"/>
                                                        <Setter Property="TextElement.Foreground" Value="#0E6B3E"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Overdue">
                                                        <Setter Property="Background" Value="#FDE8E8"/>
                                                        <Setter Property="TextElement.Foreground" Value="#B42318"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Pie chart card -->
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Payment status" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="Share of records by status" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>

                    <Grid Width="200" Height="200" Margin="0,22,0,22">
                        <Canvas x:Name="PieCanvas" Width="200" Height="200"/>
                        <Ellipse Width="118" Height="118" Fill="White"/>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="PieTotal" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="records" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <ItemsControl x:Name="LegendList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="10" Height="10" Fill="{Binding Color}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="10,0,0,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Display}" FontWeight="SemiBold"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 4. Footer -->
        <Grid Grid.Row="4" Margin="6,18,6,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource Muted}"
                       Text="Showing 1–8 of 8 records  |  Sample date range"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource PillButton}" Content="Previous" IsEnabled="False"/>
                <TextBlock Text="Page 1 of 1" VerticalAlignment="Center" Margin="18,0,8,0"
                           FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                <Button Style="{StaticResource PillButton}" Content="Next" IsEnabled="False"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>