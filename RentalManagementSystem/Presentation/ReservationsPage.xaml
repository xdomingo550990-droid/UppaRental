<UserControl x:Class="RentalManagementSystem.Presentation.ReservationsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="1000" MinHeight="620">

    <UserControl.Resources>
        <SolidColorBrush x:Key="Ink" Color="#1E3223"/>
        <SolidColorBrush x:Key="Muted" Color="#6B7A70"/>
        <SolidColorBrush x:Key="Line" Color="#E3EBE5"/>
        <SolidColorBrush x:Key="Coral" Color="#D9795B"/>
        <LinearGradientBrush x:Key="GreenGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1B3A2A" Offset="0"/>
            <GradientStop Color="#27894C" Offset="1"/>
        </LinearGradientBrush>

        <!-- White rounded card (same look as the placeholder) -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#1E3223" Direction="270" ShadowDepth="5" BlurRadius="20" Opacity="0.15"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#27894C"/>
            <Setter Property="Margin" Value="0,20,0,0"/>
        </Style>

        <!-- Rounded text input -->
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="White" BorderBrush="#CBD8CF" BorderThickness="1" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#27894C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FieldDate" TargetType="DatePicker">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Buttons -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource GreenGradient}" CornerRadius="10" Padding="18,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="White" BorderBrush="#CBD8CF" BorderThickness="1"
                                CornerRadius="10" Padding="16,9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EEF5F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E6F1E9"/>
                                <Setter Property="Foreground" Value="#27894C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid look -->
        <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        </Style>

        <Style x:Key="GridRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F3F8F4"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E6F1E9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GridCell" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <StackPanel Margin="24">

            <!-- ================= HEADER ================= -->
            <Grid>
                <StackPanel>
                    <TextBlock Text="Reservations &amp; Booking Calendar" FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource Ink}"/>
                    <TextBlock Text="Reserve units, record renter details and track payments in one place."
                               FontSize="13" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Content="+  New Reservation" Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Click="NewReservation_Click"/>
            </Grid>

            <!-- ================= STAT CARDS ================= -->
            <UniformGrid Columns="4" Margin="0,20,0,0">
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,8,0">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Active reservations" FontSize="12" Foreground="{StaticResource Muted}"/>
                            <TextBlock x:Name="StatActive" Text="0" FontSize="26" FontWeight="Bold"
                                       Foreground="{StaticResource Ink}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Width="38" Height="38" CornerRadius="10" Background="#E6F1E9"
                                HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#27894C"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}" Padding="16" Margin="8,0">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Occupied today" FontSize="12" Foreground="{StaticResource Muted}"/>
                            <TextBlock x:Name="StatOccupied" Text="0" FontSize="26" FontWeight="Bold"
                                       Foreground="{StaticResource Ink}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Width="38" Height="38" CornerRadius="10" Background="#E6F1E9"
                                HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#27894C"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}" Padding="16" Margin="8,0">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Payments collected" FontSize="12" Foreground="{StaticResource Muted}"/>
                            <TextBlock x:Name="StatCollected" Text="&#x20B1;0.00" FontSize="26" FontWeight="Bold"
                                       Foreground="{StaticResource Ink}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Width="38" Height="38" CornerRadius="10" Background="#E6F1E9"
                                HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="&#x20B1;" FontSize="17" FontWeight="Bold" Foreground="#27894C"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}" Padding="16" Margin="8,0,0,0">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Outstanding balance" FontSize="12" Foreground="{StaticResource Muted}"/>
                            <TextBlock x:Name="StatOutstanding" Text="&#x20B1;0.00" FontSize="26" FontWeight="Bold"
                                       Foreground="{StaticResource Coral}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Width="38" Height="38" CornerRadius="10" Background="#FBE4DC"
                                HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="&#x20B1;" FontSize="17" FontWeight="Bold" Foreground="#D9795B"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- ================= MAIN: calendar + list (left) | booking form (right) ================= -->
            <Grid Margin="0,20,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="370"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT -->
                <StackPanel Grid.Column="0">

                    <!-- Calendar -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <TextBlock x:Name="MonthText" Text="Month" FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource Ink}" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Today" Style="{StaticResource OutlineButton}" Padding="0"
                                            Margin="0,0,8,0" Click="Today_Click"/>
                                    <Button Content="&#xE76B;" Style="{StaticResource IconButton}" Click="PrevMonth_Click"/>
                                    <Button Content="&#xE76C;" Style="{StaticResource IconButton}" Click="NextMonth_Click"/>
                                </StackPanel>
                            </Grid>

                            <!-- Legend -->
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,12">
                                <Border Width="10" Height="10" CornerRadius="3" Background="#27894C" VerticalAlignment="Center"/>
                                <TextBlock Text="Paid" FontSize="11" Foreground="{StaticResource Muted}" Margin="5,0,16,0"/>
                                <Border Width="10" Height="10" CornerRadius="3" Background="#D99A1E" VerticalAlignment="Center"/>
                                <TextBlock Text="Partial" FontSize="11" Foreground="{StaticResource Muted}" Margin="5,0,16,0"/>
                                <Border Width="10" Height="10" CornerRadius="3" Background="#D9795B" VerticalAlignment="Center"/>
                                <TextBlock Text="Unpaid" FontSize="11" Foreground="{StaticResource Muted}" Margin="5,0,16,0"/>
                                <TextBlock Text="Click a day to filter the list and start a booking on that date."
                                           FontSize="11" Foreground="{StaticResource Muted}" FontStyle="Italic"/>
                            </StackPanel>

                            <!-- Weekday names -->
                            <UniformGrid Columns="7">
                                <TextBlock Text="Sun" HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                                <TextBlock Text="Mon" HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                                <TextBlock Text="Tue" HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                                <TextBlock Text="Wed" HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                                <TextBlock Text="Thu" HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                                <TextBlock Text="Fri" HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                                <TextBlock Text="Sat" HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                            </UniformGrid>

                            <!-- Day cells are built in code -->
                            <UniformGrid x:Name="CalendarGrid" Columns="7" Rows="6" Height="360" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Reservation list -->
                    <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                        <StackPanel>
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Reservations" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock x:Name="FilterText" Text="Showing all reservations" FontSize="12"
                                                   Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                        <Button x:Name="ShowAllButton" Content="Show all" Visibility="Collapsed"
                                                Margin="10,0,0,0" Cursor="Hand" Click="ShowAll_Click" Foreground="#27894C"
                                                Background="Transparent" BorderThickness="0" FontSize="12" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBox x:Name="SearchBox" Style="{StaticResource Field}" Width="220"
                                         HorizontalAlignment="Right" VerticalAlignment="Center"
                                         ToolTip="Search by renter, unit, phone or ID" TextChanged="SearchBox_TextChanged"/>
                            </Grid>

                            <DataGrid x:Name="ReservationGrid" Margin="0,14,0,0"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                      CanUserResizeRows="False" CanUserResizeColumns="False" CanUserSortColumns="False"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="{StaticResource Line}"
                                      BorderThickness="0" Background="Transparent" RowBackground="Transparent"
                                      RowHeight="54" MinHeight="110" SelectionMode="Single" SelectionUnit="FullRow"
                                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                      ColumnHeaderStyle="{StaticResource GridHeader}"
                                      RowStyle="{StaticResource GridRow}"
                                      CellStyle="{StaticResource GridCell}"
                                      PreviewMouseWheel="Grid_PreviewMouseWheel"
                                      MouseDoubleClick="Grid_DoubleClick">
                                <DataGrid.Columns>

                                    <DataGridTemplateColumn Header="ID" Width="62">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Id}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="RENTER" Width="*" MinWidth="140">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding RenterName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Phone}" FontSize="11" Foreground="#6B7A70" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="UNIT" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding UnitLabel}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#6B7A70"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="STAY" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StayText}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding NightsText}" FontSize="11" Foreground="#6B7A70"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="TOTAL / BALANCE" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TotalText}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding BalanceLine}" FontSize="11" Foreground="#6B7A70"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="PAYMENT" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="10" Padding="10,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#FBE4DC"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding PaymentStatus}" Value="Paid">
                                                                    <Setter Property="Background" Value="#D8EFE0"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding PaymentStatus}" Value="Partial">
                                                                    <Setter Property="Background" Value="#FBEFD2"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding PaymentStatus}" FontSize="11" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#A94B30"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding PaymentStatus}" Value="Paid">
                                                                        <Setter Property="Foreground" Value="#1E6B3B"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding PaymentStatus}" Value="Partial">
                                                                        <Setter Property="Foreground" Value="#8A6414"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="&#xE70F;" Style="{StaticResource IconButton}"
                                                            ToolTip="Edit / update" Click="EditRow_Click"/>
                                                    <Button Content="&#x20B1;" Style="{StaticResource IconButton}"
                                                            FontFamily="Segoe UI" FontWeight="Bold" FontSize="15"
                                                            ToolTip="Record payment" Click="PayRow_Click"/>
                                                    <Button Content="&#xE74D;" Style="{StaticResource IconButton}"
                                                            ToolTip="Delete" Click="DeleteRow_Click"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock x:Name="EmptyText" Text="No reservations found." HorizontalAlignment="Center"
                                       Foreground="{StaticResource Muted}" Margin="0,-70,0,40" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- RIGHT: booking form -->
                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="22"
                        Margin="18,0,0,0" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock x:Name="FormTitle" Text="New Reservation" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource Ink}"/>
                        <TextBlock Text="Reserve a unit and save the renter's details." FontSize="12"
                                   Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>

                        <!-- UNIT & STAY -->
                        <TextBlock Text="UNIT &amp; STAY" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Unit" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="UnitCombo" Style="{StaticResource FieldCombo}"
                                  DisplayMemberPath="Label" SelectionChanged="UnitCombo_SelectionChanged"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Check-in" Style="{StaticResource FieldLabel}"/>
                                <DatePicker x:Name="CheckInPicker" Style="{StaticResource FieldDate}"
                                            SelectedDateChanged="Dates_Changed"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Check-out" Style="{StaticResource FieldLabel}"/>
                                <DatePicker x:Name="CheckOutPicker" Style="{StaticResource FieldDate}"
                                            SelectedDateChanged="Dates_Changed"/>
                            </StackPanel>
                        </Grid>

                        <!-- RENTER -->
                        <TextBlock Text="RENTER DETAILS" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Full name" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="NameBox" Style="{StaticResource Field}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Contact number" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="PhoneBox" Style="{StaticResource Field}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Guests" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="GuestsBox" Style="{StaticResource Field}" Text="1"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Email" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="EmailBox" Style="{StaticResource Field}"/>
                        <TextBlock Text="Home address / ID number" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="AddressBox" Style="{StaticResource Field}"/>

                        <!-- PRICING -->
                        <TextBlock Text="PRICING" Style="{StaticResource SectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Rate per night (&#x20B1;)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="RateBox" Style="{StaticResource Field}" TextChanged="Pricing_Changed"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Security deposit (&#x20B1;)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="DepositBox" Style="{StaticResource Field}" Text="0" TextChanged="Pricing_Changed"/>
                            </StackPanel>
                        </Grid>

                        <Border Background="#F1F6F2" CornerRadius="10" Padding="14,12" Margin="0,12,0,0">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Nights" FontSize="12" Foreground="{StaticResource Muted}"/>
                                    <TextBlock x:Name="SumNights" Text="0" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <TextBlock Text="Room charge" FontSize="12" Foreground="{StaticResource Muted}"/>
                                    <TextBlock x:Name="SumRoom" Text="&#x20B1;0.00" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <TextBlock Text="Security deposit" FontSize="12" Foreground="{StaticResource Muted}"/>
                                    <TextBlock x:Name="SumDeposit" Text="&#x20B1;0.00" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </Grid>
                                <Border Height="1" Background="#D5E3D9" Margin="0,10"/>
                                <Grid>
                                    <TextBlock Text="Total due" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                                    <TextBlock x:Name="SumTotal" Text="&#x20B1;0.00" FontSize="16" FontWeight="Bold"
                                               Foreground="#27894C" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- PAYMENT -->
                        <TextBlock Text="PAYMENT" Style="{StaticResource SectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Amount paid (&#x20B1;)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="PaidBox" Style="{StaticResource Field}" Text="0" TextChanged="Pricing_Changed"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Method" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="MethodCombo" Style="{StaticResource FieldCombo}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Balance:" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="BalanceText" Text="&#x20B1;0.00" FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource Ink}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border x:Name="PayBadge" CornerRadius="10" Padding="12,3" Background="#FBE4DC"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="PayBadgeText" Text="Unpaid" FontSize="11" FontWeight="SemiBold" Foreground="#A94B30"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="Reservation status" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="StatusCombo" Style="{StaticResource FieldCombo}"/>

                        <TextBlock Text="Notes" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="NotesBox" Style="{StaticResource Field}" Height="64" TextWrapping="Wrap"
                                 AcceptsReturn="True" VerticalContentAlignment="Top" Padding="8,6"
                                 VerticalScrollBarVisibility="Auto"/>

                        <TextBlock x:Name="FormMessage" Text="" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"/>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="SaveButton" Grid.Column="0" Content="Reserve Unit"
                                    Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
                            <Button Grid.Column="2" Content="Clear" Style="{StaticResource OutlineButton}" Click="Clear_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
