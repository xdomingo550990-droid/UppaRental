<UserControl x:Class="RentalManagementSystem.Presentation.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/PageStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="16,16,16,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Settings" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Manage your profile, rental preferences, and notifications." Style="{StaticResource PageSubtitle}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Save Changes" Style="{StaticResource PrimaryButton}"
                        VerticalAlignment="Center" Click="Save_Click"/>
            </Grid>

            <!-- Two columns of cards -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: Profile + Security -->
                <StackPanel Grid.Column="0">

                    <Border Style="{StaticResource Card}" Padding="22">
                        <StackPanel>
                            <TextBlock Text="Profile" Style="{StaticResource CardHeading}"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <Border Width="56" Height="56" CornerRadius="28" Background="#C07156">
                                    <TextBlock x:Name="txtAvatar" Text="K" Foreground="White" FontWeight="Bold" FontSize="22"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                                    <TextBlock Text="Kim Vincent Domingo" FontSize="15" FontWeight="Bold" Foreground="#1E3223"/>
                                    <TextBlock Text="Landlord • 6 units" FontSize="12" Foreground="#607464" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="Full name" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource InputBorder}" Margin="0,0,0,14">
                                <TextBox x:Name="txtFullName" Text="Kim Vincent Domingo" Style="{StaticResource PlainTextBox}"/>
                            </Border>

                            <TextBlock Text="Email address" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource InputBorder}" Margin="0,0,0,14">
                                <TextBox x:Name="txtEmail" Style="{StaticResource PlainTextBox}"/>
                            </Border>

                            <TextBlock Text="Phone number" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource InputBorder}">
                                <TextBox x:Name="txtPhone" Style="{StaticResource PlainTextBox}"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="22" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="Security" Style="{StaticResource CardHeading}"/>

                            <TextBlock Text="Current password" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource InputBorder}" Margin="0,0,0,14">
                                <PasswordBox x:Name="pwdCurrent" Style="{StaticResource PlainPasswordBox}"/>
                            </Border>

                            <TextBlock Text="New password" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource InputBorder}" Margin="0,0,0,14">
                                <PasswordBox x:Name="pwdNew" Style="{StaticResource PlainPasswordBox}"/>
                            </Border>

                            <TextBlock Text="Confirm new password" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource InputBorder}" Margin="0,0,0,16">
                                <PasswordBox x:Name="pwdConfirm" Style="{StaticResource PlainPasswordBox}"/>
                            </Border>

                            <TextBlock x:Name="txtPasswordMessage" FontSize="12" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed"/>

                            <Button Content="Update Password" Style="{StaticResource OutlineButton}"
                                    HorizontalAlignment="Left" Click="UpdatePassword_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- RIGHT: Rental preferences + Notifications -->
                <StackPanel Grid.Column="2">

                    <Border Style="{StaticResource Card}" Padding="22">
                        <StackPanel>
                            <TextBlock Text="Rental Preferences" Style="{StaticResource CardHeading}"/>

                            <TextBlock Text="Business / property name" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource InputBorder}" Margin="0,0,0,14">
                                <TextBox x:Name="txtBusinessName" Text="Uppa Rental" Style="{StaticResource PlainTextBox}"/>
                            </Border>

                            <TextBlock Text="Currency" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cmbCurrency" SelectedIndex="0" Margin="0,0,0,14">
                                <ComboBoxItem Content="₱  Philippine Peso (PHP)"/>
                                <ComboBoxItem Content="$  US Dollar (USD)"/>
                                <ComboBoxItem Content="€  Euro (EUR)"/>
                            </ComboBox>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Rent due day of month" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="cmbDueDay" SelectedIndex="1">
                                        <ComboBoxItem Content="1st"/>
                                        <ComboBoxItem Content="5th"/>
                                        <ComboBoxItem Content="10th"/>
                                        <ComboBoxItem Content="15th"/>
                                        <ComboBoxItem Content="20th"/>
                                        <ComboBoxItem Content="25th"/>
                                        <ComboBoxItem Content="30th"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Grace period (days)" Style="{StaticResource FieldLabel}"/>
                                    <Border Style="{StaticResource InputBorder}">
                                        <TextBox x:Name="txtGraceDays" Text="3" Style="{StaticResource PlainTextBox}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="22" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="Notifications" Style="{StaticResource CardHeading}"/>
                            <CheckBox x:Name="chkPaymentAlerts" Content="Email me when a payment is received"
                                      Style="{StaticResource ToggleSwitch}" IsChecked="True" Margin="0,0,0,16"/>
                            <CheckBox x:Name="chkOverdueAlerts" Content="Remind me about overdue rent"
                                      Style="{StaticResource ToggleSwitch}" IsChecked="True" Margin="0,0,0,16"/>
                            <CheckBox x:Name="chkReservationAlerts" Content="Notify me of new reservation requests"
                                      Style="{StaticResource ToggleSwitch}" IsChecked="True" Margin="0,0,0,16"/>
                            <CheckBox x:Name="chkMessageAlerts" Content="Notify me of messages from renters"
                                      Style="{StaticResource ToggleSwitch}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>