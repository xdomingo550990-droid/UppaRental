<UserControl x:Class="RentalManagementSystem.Presentation.AuthCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <LinearGradientBrush x:Key="Accent" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1B3A2A" Offset="0"/>
            <GradientStop Color="#27894C" Offset="1"/>
        </LinearGradientBrush>
        <FontFamily x:Key="AppFont">Poppins, Segoe UI</FontFamily>

        <Style x:Key="FieldTextBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="12,0,38,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="#EEEEEE"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldPasswordBox" TargetType="PasswordBox">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="12,0,38,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="#EEEEEE"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#9A9A9A"/>
            <Setter Property="Margin" Value="14,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <Style x:Key="FieldIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <Style x:Key="EyeToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ToolTip" Value="Show / hide password"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent">
                            <TextBlock x:Name="icon" Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="13" Foreground="#333333"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="icon" Property="Foreground" Value="#27894C"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="icon" Property="Text" Value="&#xED1A;"/>
                                <Setter TargetName="icon" Property="Foreground" Value="#27894C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource Accent}" CornerRadius="6" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="scale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="Opacity" To="0.92" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" BorderBrush="White"
                                BorderThickness="1" CornerRadius="6" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="scale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Main Card Container -->
    <Border Width="800" Height="480" Background="White" CornerRadius="30"
            HorizontalAlignment="Center" VerticalAlignment="Center">

        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="2" Opacity="0.18"/>
        </Border.Effect>

        <Grid>
            <Grid.Clip>
                <RectangleGeometry Rect="0,0,800,480" RadiusX="30" RadiusY="30"/>
            </Grid.Clip>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- REGISTER FORM -->
            <StackPanel x:Name="RegisterPanel" Grid.Column="0" VerticalAlignment="Center" Margin="40,0">
                <TextBlock Text="Sign Up Account" FontFamily="{StaticResource AppFont}" FontSize="24"
                           FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,14"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <TextBox x:Name="RegFirstName" Style="{StaticResource FieldTextBox}"
                                 Text="{Binding FirstName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="{Binding ElementName=RegFirstNameHint}" TextChanged="Field_Changed"/>
                        <TextBlock x:Name="RegFirstNameHint" Text="First Name" Style="{StaticResource HintText}"/>
                    </Grid>

                    <Grid Grid.Column="2">
                        <TextBox x:Name="RegLastName" Style="{StaticResource FieldTextBox}"
                                 Text="{Binding LastName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="{Binding ElementName=RegLastNameHint}" TextChanged="Field_Changed"/>
                        <TextBlock x:Name="RegLastNameHint" Text="Last Name" Style="{StaticResource HintText}"/>
                    </Grid>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <TextBox x:Name="RegUsername" Style="{StaticResource FieldTextBox}"
                             Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Tag="{Binding ElementName=RegUsernameHint}" TextChanged="Field_Changed"/>
                    <TextBlock x:Name="RegUsernameHint" Text="Username" Style="{StaticResource HintText}"/>
                    <TextBlock Text="&#xE77B;" Style="{StaticResource FieldIcon}"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <TextBox x:Name="RegEmail" Style="{StaticResource FieldTextBox}"
                             Text="{Binding EmailAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Tag="{Binding ElementName=RegEmailHint}" TextChanged="Field_Changed"/>
                    <TextBlock x:Name="RegEmailHint" Text="Email" Style="{StaticResource HintText}"/>
                    <TextBlock Text="&#xE715;" Style="{StaticResource FieldIcon}"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <PasswordBox x:Name="RegPassword" Style="{StaticResource FieldPasswordBox}"
                                 Tag="{Binding ElementName=RegPasswordHint}" PasswordChanged="Field_Changed"/>
                    <TextBox x:Name="RegPasswordPlain" Style="{StaticResource FieldTextBox}" Visibility="Collapsed"
                             Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Tag="{Binding ElementName=RegPasswordHint}" TextChanged="Field_Changed"/>
                    <TextBlock x:Name="RegPasswordHint" Text="Password" Style="{StaticResource HintText}"/>
                    <ToggleButton Style="{StaticResource EyeToggle}" Click="TogglePassword_Click"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <PasswordBox x:Name="RegConfirmPassword" Style="{StaticResource FieldPasswordBox}"
                                 Tag="{Binding ElementName=RegConfirmPasswordHint}" PasswordChanged="Field_Changed"/>
                    <TextBox x:Name="RegConfirmPasswordPlain" Style="{StaticResource FieldTextBox}" Visibility="Collapsed"
                             Tag="{Binding ElementName=RegConfirmPasswordHint}" TextChanged="Field_Changed"/>
                    <TextBlock x:Name="RegConfirmPasswordHint" Text="Confirm password" Style="{StaticResource HintText}"/>
                    <ToggleButton Style="{StaticResource EyeToggle}" Click="TogglePassword_Click"/>
                </Grid>

                <TextBlock x:Name="RegMessage" FontFamily="{StaticResource AppFont}" FontSize="11"
                           FontWeight="SemiBold" Foreground="#C84B41" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="0,0,0,6" Visibility="Collapsed"/>

                <Button Content="Register" Style="{StaticResource PrimaryButton}" Click="Register_Click"/>
            </StackPanel>

            <!-- LOGIN FORM -->
            <StackPanel x:Name="LoginPanel" Grid.Column="1" VerticalAlignment="Center" Margin="50,0" Opacity="0" IsHitTestVisible="False">
                <TextBlock Text="Login" FontFamily="{StaticResource AppFont}" FontSize="26"
                           FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <Grid Margin="0,0,0,12">
                    <TextBox x:Name="LoginUsername" Style="{StaticResource FieldTextBox}"
                             Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Tag="{Binding ElementName=LoginUsernameHint}" TextChanged="Field_Changed"/>
                    <TextBlock x:Name="LoginUsernameHint" Text="Username" Style="{StaticResource HintText}"/>
                    <TextBlock Text="&#xE77B;" Style="{StaticResource FieldIcon}"/>
                </Grid>

                <Grid Margin="0,0,0,16">
                    <PasswordBox x:Name="LoginPassword" Style="{StaticResource FieldPasswordBox}"
                                 Tag="{Binding ElementName=LoginPasswordHint}" PasswordChanged="Field_Changed"/>
                    <TextBox x:Name="LoginPasswordPlain" Style="{StaticResource FieldTextBox}" Visibility="Collapsed"
                             Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Tag="{Binding ElementName=LoginPasswordHint}" TextChanged="Field_Changed"/>
                    <TextBlock x:Name="LoginPasswordHint" Text="Password" Style="{StaticResource HintText}"/>
                    <ToggleButton Style="{StaticResource EyeToggle}" Click="TogglePassword_Click"/>
                </Grid>

                <Button Content="Login" Style="{StaticResource PrimaryButton}" Click="Login_Click"/>
            </StackPanel>

            <!-- SLIDING OVERLAY -->
            <Border x:Name="Overlay" Grid.ColumnSpan="2" Width="520" HorizontalAlignment="Left" Background="{StaticResource Accent}" CornerRadius="120">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="OverlayTransform" X="400"/>
                </Border.RenderTransform>

                <Grid>
                    <StackPanel x:Name="WelcomeBackPanel" HorizontalAlignment="Left" Width="400" VerticalAlignment="Center">
                        <TextBlock Text="Welcome Back!" Foreground="White" FontFamily="{StaticResource AppFont}" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Already have an account? Take a look at your own record." Foreground="White" FontFamily="{StaticResource AppFont}" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,16"/>
                        <Button Content="Login Now" Style="{StaticResource GhostButton}" Click="ShowLogin_Click"/>
                    </StackPanel>

                    <StackPanel x:Name="HelloPanel" HorizontalAlignment="Right" Width="400" VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False">
                        <TextBlock Text="Hello, Welcome!" Foreground="White" FontFamily="{StaticResource AppFont}" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Don't have an account? Register now." Foreground="White" FontFamily="{StaticResource AppFont}" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,16"/>
                        <Button Content="Register" Style="{StaticResource GhostButton}" Click="ShowRegister_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Close Button & Logo -->
            <Button Grid.ColumnSpan="2" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,14,0" Cursor="Hand" Foreground="#555555" Background="#CCFFFFFF" BorderThickness="0" Click="Close_Click"/>
            <Image Margin="33,28,340,426" Source="/Resources/Icons/houseLogo.png" Stretch="Fill"/>
        </Grid>
    </Border>
</UserControl>