<UserControl x:Class="RentalManagementSystem.Presentation.AuthCard"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      >

    <UserControl.Resources>
        <LinearGradientBrush x:Key="Accent" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1B3A2A" Offset="0"/>
            <GradientStop Color="#27894C" Offset="1"/>
        </LinearGradientBrush>
        <FontFamily x:Key="AppFont">Poppins, Segoe UI</FontFamily>

        <!-- Rounded grey input (works for TextBox and PasswordBox) -->
        <Style x:Key="FieldTextBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,0,38,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#EEEEEE"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldPasswordBox" TargetType="PasswordBox">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,0,38,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#EEEEEE"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#9A9A9A"/>
            <Setter Property="Margin" Value="14,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <Style x:Key="FieldIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <!-- Buttons -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource Accent}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" BorderBrush="White"
                                BorderThickness="1" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SocialButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="6"
                                Background="White">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F2F2F2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clickable text link (Forgot Password?, Back to Login) -->
        <Style x:Key="LinkText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#27894C"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="TextDecorations" Value="Underline"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- Card -->
    <Border Width="800" Height="480" Background="White" CornerRadius="30"
                HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.2"/>
        </Border.Effect>

        <Grid>
            <!-- Rounds the card and clips the sliding overlay -->
            <Grid.Clip>
                <RectangleGeometry Rect="0,0,800,480" RadiusX="30" RadiusY="30"/>
            </Grid.Clip>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============ REGISTER FORM (left) ============ -->
            <StackPanel x:Name="RegisterPanel" Grid.Column="0" VerticalAlignment="Center"
                            Margin="50,0">
                <TextBlock Text="Sign Up Account" FontFamily="{StaticResource AppFont}" FontSize="26"
                               FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <Grid Margin="0,0,0,12">
                    <TextBox x:Name="RegUsername" Style="{StaticResource FieldTextBox}"
                                 Tag="{Binding ElementName=RegUsernameHint}" TextChanged="Field_Changed"/>
                    <TextBlock x:Name="RegUsernameHint" Text="Username" Style="{StaticResource HintText}"/>
                    <TextBlock Text="&#xE77B;" Style="{StaticResource FieldIcon}"/>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <TextBox x:Name="RegEmail" Style="{StaticResource FieldTextBox}"
                                 Tag="{Binding ElementName=RegEmailHint}" TextChanged="Field_Changed"/>
                    <TextBlock x:Name="RegEmailHint" Text="Email" Style="{StaticResource HintText}"/>
                    <TextBlock Text="&#xE715;" Style="{StaticResource FieldIcon}"/>
                </Grid>

                <Grid Margin="0,0,0,16">
                    <PasswordBox x:Name="RegPassword" Style="{StaticResource FieldPasswordBox}"
                                     Tag="{Binding ElementName=RegPasswordHint}" PasswordChanged="Field_Changed"/>
                    <TextBlock x:Name="RegPasswordHint" Text="Password" Style="{StaticResource HintText}"/>
                    <TextBlock Text="&#xE72E;" Style="{StaticResource FieldIcon}"/>
                </Grid>

                <Button Content="Register" Style="{StaticResource PrimaryButton}" Click="Register_Click"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- ============ LOGIN FORM (right) ============ -->
            <StackPanel x:Name="LoginPanel" Grid.Column="1" VerticalAlignment="Center"
                            Margin="50,0" Opacity="0" IsHitTestVisible="False">
                <TextBlock Text="Login" FontFamily="{StaticResource AppFont}" FontSize="26"
                               FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <Grid Margin="0,0,0,12">
                    <TextBox x:Name="LoginUsername" Style="{StaticResource FieldTextBox}"
                                 Tag="{Binding ElementName=LoginUsernameHint}" TextChanged="Field_Changed"/>
                    <TextBlock x:Name="LoginUsernameHint" Text="Username" Style="{StaticResource HintText}"/>
                    <TextBlock Text="&#xE77B;" Style="{StaticResource FieldIcon}"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <PasswordBox x:Name="LoginPassword" Style="{StaticResource FieldPasswordBox}"
                                     Tag="{Binding ElementName=LoginPasswordHint}" PasswordChanged="Field_Changed"/>
                    <TextBlock x:Name="LoginPasswordHint" Text="Password" Style="{StaticResource HintText}"/>
                    <TextBlock Text="&#xE72E;" Style="{StaticResource FieldIcon}"/>
                </Grid>

                <TextBlock Text="Forgot Password?" Style="{StaticResource LinkText}"
                           Margin="0,0,0,12" MouseLeftButtonUp="ForgotPassword_Click"/>

                <Button Content="Login" Style="{StaticResource PrimaryButton}" Click="Login_Click"/>

                <TextBlock Text="" FontFamily="{StaticResource AppFont}"
                               FontSize="11" HorizontalAlignment="Center" Margin="0,16,0,10"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                   
                </StackPanel>
            </StackPanel>

            <!-- ============ FORGOT PASSWORD FORM (right, replaces login) ============ -->
            <StackPanel x:Name="ForgotPanel" Grid.Column="1" VerticalAlignment="Center"
                            Margin="50,0" Opacity="0" IsHitTestVisible="False">
                <TextBlock Text="Reset Password" FontFamily="{StaticResource AppFont}" FontSize="26"
                               FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                <TextBlock Text="Enter your username and choose a new password."
                               FontFamily="{StaticResource AppFont}" FontSize="11" Foreground="#666666"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,16"/>

                <Grid Margin="0,0,0,12">
                    <TextBox x:Name="ForgotUsername" Style="{StaticResource FieldTextBox}"
                                 Tag="{Binding ElementName=ForgotUsernameHint}" TextChanged="Field_Changed"/>
                    <TextBlock x:Name="ForgotUsernameHint" Text="Username" Style="{StaticResource HintText}"/>
                    <TextBlock Text="&#xE77B;" Style="{StaticResource FieldIcon}"/>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <PasswordBox x:Name="ForgotNewPassword" Style="{StaticResource FieldPasswordBox}"
                                     Tag="{Binding ElementName=ForgotNewPasswordHint}" PasswordChanged="Field_Changed"/>
                    <TextBlock x:Name="ForgotNewPasswordHint" Text="New password" Style="{StaticResource HintText}"/>
                    <TextBlock Text="&#xE72E;" Style="{StaticResource FieldIcon}"/>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <PasswordBox x:Name="ForgotConfirmPassword" Style="{StaticResource FieldPasswordBox}"
                                     Tag="{Binding ElementName=ForgotConfirmPasswordHint}" PasswordChanged="Field_Changed"/>
                    <TextBlock x:Name="ForgotConfirmPasswordHint" Text="Confirm password" Style="{StaticResource HintText}"/>
                    <TextBlock Text="&#xE72E;" Style="{StaticResource FieldIcon}"/>
                </Grid>

                <TextBlock x:Name="ForgotMessage" FontFamily="{StaticResource AppFont}" FontSize="11"
                               FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"
                               Margin="0,0,0,10" Visibility="Collapsed"/>

                <Button Content="Reset Password" Style="{StaticResource PrimaryButton}" Click="ResetPassword_Click"/>
                <TextBlock Text="Back to Login" Style="{StaticResource LinkText}"
                           Margin="0,14,0,0" MouseLeftButtonUp="BackToLogin_Click"/>
            </StackPanel>

            <!-- ============ BLUE SLIDING OVERLAY ============ -->
            <!-- 520 wide: 400 visible + 120 hidden past the card edge (hides outer rounding) -->
            <Border x:Name="Overlay" Grid.ColumnSpan="2" Width="520"
                        HorizontalAlignment="Left" Background=
                        "{StaticResource Accent}"
                        CornerRadius="120">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="OverlayTransform" X="400"/>
                </Border.RenderTransform>

                <Grid>
                    <!-- shown while overlay is on the right (register mode) -->
                    <StackPanel x:Name="WelcomeBackPanel" HorizontalAlignment="Left" Width="400"
                                    VerticalAlignment="Center">
                        <TextBlock Text="Welcome Back!" Foreground="White" FontFamily="{StaticResource AppFont}"
                                       FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Already have an account? Take a look at your own record." Foreground="White"
                                       FontFamily="{StaticResource AppFont}" FontSize="12"
                                       HorizontalAlignment="Center" Margin="0,6,0,16"/>
                        <Button Content="Login Now" Style="{StaticResource GhostButton}" Click="ShowLogin_Click"/>
                    </StackPanel>

                    <!-- shown while overlay is on the left (login mode) -->
                    <StackPanel x:Name="HelloPanel" HorizontalAlignment="Right" Width="400"
                                    VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False">
                        <TextBlock Text="Hello, Welcome!" Foreground="White" FontFamily="{StaticResource AppFont}"
                                       FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Don't have an account? Register now." Foreground="White"
                                       FontFamily="{StaticResource AppFont}" FontSize="12"
                                       HorizontalAlignment="Center" Margin="0,6,0,16"/>
                        <Button Content="Register" Style="{StaticResource GhostButton}" Click="ShowRegister_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Close button -->
            <Button Grid.ColumnSpan="2" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                        Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,14,14,0" Cursor="Hand" Foreground="#555555" Background="#CCFFFFFF"
                        BorderThickness="0" Click="Close_Click"/>
            <Image Margin="33,28,340,426" Source="/Resources/Icons/houseLogo.png" Stretch="Fill"/>
        </Grid>
    </Border>
</UserControl>
