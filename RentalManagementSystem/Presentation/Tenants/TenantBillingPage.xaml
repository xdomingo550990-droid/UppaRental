<UserControl x:Class="RentalManagementSystem.Presentation.TenantBillingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/PageStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Underlined tab: Invoices | Payment History -->
            <Style x:Key="BillingTab" TargetType="RadioButton">
                <Setter Property="Foreground" Value="#7A8C7E"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,0,26,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="line" BorderThickness="0,0,0,3" BorderBrush="Transparent" Padding="2,0,2,8">
                                <ContentPresenter RecognizesAccessKey="False"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="#1E3223"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Foreground" Value="#1E3223"/>
                                    <Setter TargetName="line" Property="BorderBrush" Value="#C07156"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="View your rent invoices, payment history, and upcoming dues."
                           Style="{StaticResource PageSubtitle}"
                           FontWeight="SemiBold"
                           Foreground="#1E3223"/>
            </StackPanel>

            <Button Grid.Column="1" Content="Pay Next Due" Style="{StaticResource PrimaryButton}"
                    VerticalAlignment="Center" Click="PayNextDue_Click"/>
        </Grid>

        <!-- 2. Summary cards -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Background="#1E3223" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="Total paid" Style="{StaticResource StatLabel}" Foreground="#C9D8CC"/>
                    <TextBlock x:Name="txtPaid" Text="₱0.00" Style="{StaticResource StatValue}" Foreground="White"/>
                    <TextBlock x:Name="txtPaidNote" Text="" Style="{StaticResource StatNote}" Foreground="#C9D8CC"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="Upcoming" Style="{StaticResource StatLabel}"/>
                    <TextBlock x:Name="txtPending" Text="₱0.00" Style="{StaticResource StatValue}" Foreground="#8C6B00"/>
                    <TextBlock x:Name="txtPendingNote" Text="" Style="{StaticResource StatNote}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="Overdue" Style="{StaticResource StatLabel}"/>
                    <TextBlock x:Name="txtOverdue" Text="₱0.00" Style="{StaticResource StatValue}" Foreground="#A81C0C"/>
                    <TextBlock x:Name="txtOverdueNote" Text="" Style="{StaticResource StatNote}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. Main card: tabs (Invoices | Payment History) + tables -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Tabs -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <RadioButton x:Name="tabInvoices" Content="Invoices" GroupName="BillingTabs" IsChecked="True"
                                     Style="{StaticResource BillingTab}" Checked="Tab_Checked"/>
                        <RadioButton x:Name="tabHistory" Content="Payment History" GroupName="BillingTabs"
                                     Style="{StaticResource BillingTab}" Checked="Tab_Checked"/>
                    </StackPanel>

                    <!-- Only visible on the Payment History tab (follows dgHistory's visibility) -->
                    <TextBlock x:Name="txtHistoryTotal" HorizontalAlignment="Right" VerticalAlignment="Center"
                               FontSize="13" FontWeight="SemiBold" Foreground="#1E3223"
                               Text=""
                               Visibility="{Binding Visibility, ElementName=dgHistory}"/>
                </Grid>

                <!-- Filter Pills (Invoices tab only) -->
                <StackPanel x:Name="FilterBar" Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
                    <RadioButton x:Name="rbAll" Content="All" Tag="All" IsChecked="True"
                                 Style="{StaticResource FilterPill}" Checked="Filter_Checked"/>
                    <RadioButton x:Name="rbPaid" Content="Paid" Tag="Paid"
                                 Style="{StaticResource FilterPill}" Checked="Filter_Checked"/>
                    <RadioButton x:Name="rbPendingFilter" Content="Pending" Tag="Pending"
                                 Style="{StaticResource FilterPill}" Checked="Filter_Checked"/>
                    <RadioButton x:Name="rbOverdue" Content="Overdue" Tag="Overdue"
                                 Style="{StaticResource FilterPill}" Checked="Filter_Checked"/>
                </StackPanel>

                <!-- Invoices Table -->
                <DataGrid Grid.Row="2" x:Name="dgInvoices" Style="{StaticResource AppDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="INVOICE #" Binding="{Binding InvoiceNo}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#27894C"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="UNIT" Binding="{Binding Unit}" Width="*"/>
                        <DataGridTextColumn Header="PERIOD" Binding="{Binding Period}" Width="110"/>
                        <DataGridTextColumn Header="DUE DATE" Binding="{Binding DueDate}" Width="120"/>
                        <DataGridTextColumn Header="AMOUNT" Binding="{Binding AmountText}" Width="130">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="STATUS" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource StatusBadge}">
                                        <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="Bold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="ACTIONS" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="View" Style="{StaticResource LinkButton}" Click="View_Click"/>
                                        <Button Content="Pay Now" Click="PayNow_Click">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Paid">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Payment History Table (Payment History tab) -->
                <DataGrid Grid.Row="1" Grid.RowSpan="2" x:Name="dgHistory" Style="{StaticResource AppDataGrid}"
                          Visibility="Collapsed">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="RECEIPT #" Binding="{Binding ReceiptNo}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#27894C"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="INVOICE #" Binding="{Binding InvoiceNo}" Width="110"/>
                        <DataGridTextColumn Header="PERIOD" Binding="{Binding Period}" Width="110"/>
                        <DataGridTextColumn Header="DATE PAID" Binding="{Binding DatePaidText}" Width="130"/>
                        <DataGridTextColumn Header="METHOD" Binding="{Binding Method}" Width="150"/>
                        <DataGridTextColumn Header="REFERENCE" Binding="{Binding Reference}" Width="*"/>
                        <DataGridTextColumn Header="AMOUNT" Binding="{Binding Amount, StringFormat='₱{0:N2}'}" Width="130">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Receipt" Style="{StaticResource LinkButton}" Click="Receipt_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
