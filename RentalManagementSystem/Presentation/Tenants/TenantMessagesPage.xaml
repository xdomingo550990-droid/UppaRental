<UserControl x:Class="RentalManagementSystem.Presentation.TenantMessagesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="1100"
             d:DesignHeight="700">

    <UserControl.Resources>
        <!-- Theme Colors -->
        <SolidColorBrush x:Key="PrimaryGreen" Color="#1E3223"/>
        <SolidColorBrush x:Key="PrimaryGreenLight" Color="#E8EFEA"/>
        <SolidColorBrush x:Key="SurfaceWhite" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextDark" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E2E8F0"/>

        <!-- Custom Send Button Style -->
        <Style x:Key="SendButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryGreen}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="20" Background="{TemplateBinding Background}">
                            <TextBlock Text="&#xE725;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="15" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A4531"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListBoxItem Selection Style -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,10">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryGreenLight}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Main Container Card -->
        <Border Background="{StaticResource SurfaceWhite}" CornerRadius="12" MinHeight="600">
            <Border.Effect>
                <DropShadowEffect Color="#1E3223" Direction="270" ShadowDepth="5" BlurRadius="20" Opacity="0.15"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <!-- Landlord List -->
                    <ColumnDefinition Width="*"/>
                    <!-- Active Chat Area -->
                </Grid.ColumnDefinitions>

                <!-- LEFT COLUMN: Landlord Conversation List -->
                <Border Grid.Column="0" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,0" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Section Title -->
                        <TextBlock Grid.Row="0" Text="My Landlord" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryGreen}" Margin="0,0,0,16"/>

                        <!-- Conversation List -->
                        <ListBox x:Name="LstLandlords" Grid.Row="1" BorderThickness="0" Background="Transparent"
                                 SelectionChanged="LstLandlords_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Avatar Circle -->
                                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20"
                                                Background="{StaticResource PrimaryGreenLight}" Margin="0,0,12,0">
                                            <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="18" Foreground="{StaticResource PrimaryGreen}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Name and Role Info -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding LandlordName}" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextDark}" FontSize="14"/>
                                            <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource TextMuted}"
                                                       FontSize="12" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- RIGHT COLUMN: Active Chat Window -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Header -->
                        <RowDefinition Height="*"/>
                        <!-- Messages -->
                        <RowDefinition Height="Auto"/>
                        <!-- Input Field -->
                    </Grid.RowDefinitions>

                    <!-- Chat Header (green gradient) -->
                    <Border Grid.Row="0" CornerRadius="0,12,0,0" Padding="20,16">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#1E3223" Offset="0"/>
                                <GradientStop Color="#2E6B47" Offset="0.65"/>
                                <GradientStop Color="#3F8A58" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <TextBlock x:Name="TxtHeaderLandlord" Text="Select a conversation"
                                       FontSize="16" FontWeight="Bold" Foreground="White"/>
                            <TextBlock x:Name="TxtHeaderSubtitle" Text="Choose your landlord from the left to start messaging"
                                       FontSize="12" Foreground="#CFE3D4" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Message History ScrollViewer -->
                    <ScrollViewer x:Name="ChatScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
                        <ItemsControl x:Name="MessagesItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4,0,4">
                                        <Border x:Name="BubbleBorder" CornerRadius="12" Padding="12,8" MaxWidth="380">
                                            <StackPanel>
                                                <TextBlock x:Name="TxtMessage" Text="{Binding Content}" TextWrapping="Wrap" FontSize="13"/>
                                                <TextBlock x:Name="TxtTime" Text="{Binding Timestamp, StringFormat='hh:mm tt'}"
                                                           FontSize="10" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <DataTemplate.Triggers>
                                        <!-- Sent by me, the Tenant (Right Side, Dark Green) -->
                                        <DataTrigger Binding="{Binding IsSentByMe}" Value="True">
                                            <Setter TargetName="BubbleBorder" Property="HorizontalAlignment" Value="Right"/>
                                            <Setter TargetName="BubbleBorder" Property="Background" Value="{StaticResource PrimaryGreen}"/>
                                            <Setter TargetName="TxtMessage" Property="Foreground" Value="White"/>
                                            <Setter TargetName="TxtTime" Property="Foreground" Value="#A3B899"/>
                                            <Setter TargetName="TxtTime" Property="HorizontalAlignment" Value="Right"/>
                                        </DataTrigger>

                                        <!-- Sent by Landlord (Left Side, Gray Bubble) -->
                                        <DataTrigger Binding="{Binding IsSentByMe}" Value="False">
                                            <Setter TargetName="BubbleBorder" Property="HorizontalAlignment" Value="Left"/>
                                            <Setter TargetName="BubbleBorder" Property="Background" Value="#F1F5F9"/>
                                            <Setter TargetName="TxtMessage" Property="Foreground" Value="{StaticResource TextDark}"/>
                                            <Setter TargetName="TxtTime" Property="Foreground" Value="{StaticResource TextMuted}"/>
                                            <Setter TargetName="TxtTime" Property="HorizontalAlignment" Value="Left"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Message Input Area -->
                    <Border Grid.Row="2" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="TxtInput" Grid.Column="0" Height="40" Padding="12,0"
                                     VerticalContentAlignment="Center" FontSize="13"
                                     BorderBrush="{StaticResource BorderColor}"
                                     KeyDown="TxtInput_KeyDown"/>

                            <Button Grid.Column="1" Style="{StaticResource SendButtonStyle}"
                                    Margin="10,0,0,0" Click="BtnSend_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
