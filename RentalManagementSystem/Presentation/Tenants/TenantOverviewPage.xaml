<UserControl x:Class="RentalManagementSystem.Presentation.TenantOverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/PropertyCardStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="GoldBrush" Color="#E0B04A"/>
            <SolidColorBrush x:Key="CreamBrush" Color="#F6F1E3"/>
            <SolidColorBrush x:Key="SoftTextBrush" Color="#C9D6CC"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Green gradient page background -->
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#142219" Offset="0"/>
                <GradientStop Color="#1E3223" Offset="0.45"/>
                <GradientStop Color="#2E5039" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== Header + filter bar ===== -->
        <Border Grid.Row="0" Padding="24,22,24,18"
                Background="#14FFFFFF"
                BorderBrush="#26FFFFFF" BorderThickness="0,0,0,1">
            <StackPanel HorizontalAlignment="Center" MaxWidth="1100">

                <TextBlock Text="EXPLORE LISTINGS" HorizontalAlignment="Center"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource GoldBrush}"
                           Margin="0,0,0,6"/>

                <TextBlock HorizontalAlignment="Center" FontSize="30" FontWeight="Bold"
                           Foreground="{StaticResource CreamBrush}">
                    <Run Text="Ready to Find Your "/>
                    <Run Text="Dream" FontFamily="Georgia" FontStyle="Italic"
                         Foreground="{StaticResource GoldBrush}"/>
                    <Run Text=" Property?"/>
                </TextBlock>

                <TextBlock Text="Browse by popularity, price, availability or lease length."
                           HorizontalAlignment="Center" TextAlignment="Center"
                           FontSize="13" Foreground="{StaticResource SoftTextBrush}"
                           Margin="0,6,0,16"/>

                <!-- Chips in a white pill -->
                <Border HorizontalAlignment="Center" Background="White"
                        CornerRadius="26" Padding="8,6">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.35"
                                          Color="Black"/>
                    </Border.Effect>
                    <WrapPanel HorizontalAlignment="Center">
                        <RadioButton Style="{StaticResource ChipStyle}" Content="All" Tag="All" IsChecked="True" Checked="Category_Checked"/>
                        <RadioButton Style="{StaticResource ChipStyle}" Content="Most Popular" Tag="Popular" Checked="Category_Checked"/>
                        <RadioButton Style="{StaticResource ChipStyle}" Content="Most Affordable" Tag="Affordable" Checked="Category_Checked"/>
                        <RadioButton Style="{StaticResource ChipStyle}" Content="Available" Tag="Available" Checked="Category_Checked"/>
                        <RadioButton Style="{StaticResource ChipStyle}" Content="Reserved" Tag="Reserved" Checked="Category_Checked"/>
                        <RadioButton Style="{StaticResource ChipStyle}" Content="Occupied" Tag="Occupied" Checked="Category_Checked"/>
                        <RadioButton Style="{StaticResource ChipStyle}" Content="Long Term" Tag="Long" Checked="Category_Checked"/>
                        <RadioButton Style="{StaticResource ChipStyle}" Content="Short Term" Tag="Short" Checked="Category_Checked"/>
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ===== Category sections ===== -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False">
            <ItemsControl x:Name="icSections"
                          MaxWidth="1100"
                          Margin="24,20,24,32"
                          HorizontalAlignment="Center"
                          ItemTemplate="{StaticResource GallerySectionTemplate}"
                          Button.Click="ReadMore_Click"/>
        </ScrollViewer>
    </Grid>
</UserControl>