<UserControl x:Class="RentalManagementSystem.Presentation.TenantReservationsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Robust Pack URI prevents resource lookup failures -->
                <ResourceDictionary Source="pack://application:,,,/Resources/PageStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Reservation status badge -->
            <Style x:Key="ResBadge" TargetType="Border">
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="10,3"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="Background" Value="#EEF1EF"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Status}" Value="Confirmed">
                        <Setter Property="Background" Value="#DDF3E4"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="Pending">
                        <Setter Property="Background" Value="#FFF1CC"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                        <Setter Property="Background" Value="#FBE0DC"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ResBadgeText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="#4B5B50"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Status}" Value="Confirmed">
                        <Setter Property="Foreground" Value="#1E6B3B"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="Pending">
                        <Setter Property="Foreground" Value="#8C6B00"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                        <Setter Property="Foreground" Value="#A81C0C"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <TextBlock Grid.Row="0" Margin="0,0,0,20" TextWrapping="Wrap"
                   Text="Track the units you've reserved, your downpayments, and move-in dates. To reserve another unit, browse the Overview page."
                   Style="{StaticResource PageSubtitle}" FontWeight="SemiBold" Foreground="#1E3223"/>

        <!-- 2. Summary cards -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Background="#1E3223" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="Active reservations" Style="{StaticResource StatLabel}" Foreground="#C9D8CC"/>
                    <TextBlock x:Name="txtActive" Text="0" Style="{StaticResource StatValue}" Foreground="White"/>
                    <TextBlock x:Name="txtActiveNote" Text="" Style="{StaticResource StatNote}" Foreground="#C9D8CC"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="Downpayments paid" Style="{StaticResource StatLabel}"/>
                    <TextBlock x:Name="txtDownPaid" Text="₱0.00" Style="{StaticResource StatValue}" Foreground="#27894C"/>
                    <TextBlock x:Name="txtDownPaidNote" Text="" Style="{StaticResource StatNote}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="Next move-in" Style="{StaticResource StatLabel}"/>
                    <TextBlock x:Name="txtNextMoveIn" Text="—" Style="{StaticResource StatValue}" Foreground="#1E3223"/>
                    <TextBlock x:Name="txtNextMoveInNote" Text="" Style="{StaticResource StatNote}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. Reservations card (Filters + DataGrid) -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Filter Pills -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                    <RadioButton x:Name="rbAll" Content="All" Tag="All" IsChecked="True"
                                 Style="{StaticResource FilterPill}" Checked="Filter_Checked"/>
                    <RadioButton x:Name="rbConfirmed" Content="Confirmed" Tag="Confirmed"
                                 Style="{StaticResource FilterPill}" Checked="Filter_Checked"/>
                    <RadioButton x:Name="rbPending" Content="Pending" Tag="Pending"
                                 Style="{StaticResource FilterPill}" Checked="Filter_Checked"/>
                    <RadioButton x:Name="rbCancelled" Content="Cancelled" Tag="Cancelled"
                                 Style="{StaticResource FilterPill}" Checked="Filter_Checked"/>
                </StackPanel>

                <!-- Reservations table -->
                <DataGrid Grid.Row="1" x:Name="dgReservations" Style="{StaticResource AppDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="RESERVATION #" Binding="{Binding ReservationNo}" Width="130">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#27894C"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="UNIT" Binding="{Binding UnitLabel}" Width="*" MinWidth="150"/>
                        <DataGridTextColumn Header="MOVE-IN" Binding="{Binding MoveInText}" Width="115"/>
                        <DataGridTextColumn Header="TERM" Binding="{Binding TermText}" Width="90"/>
                        <DataGridTextColumn Header="TOTAL RENT" Binding="{Binding TotalText}" Width="125">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="DOWNPAYMENT (20%)" Binding="{Binding DownText}" Width="150"/>
                        <DataGridTemplateColumn Header="STATUS" Width="115">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ResBadge}">
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource ResBadgeText}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="ACTIONS" Width="250">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="View" Style="{StaticResource LinkButton}" Click="View_Click"/>

                                        <Button Content="Pay Downpayment" Click="PayDown_Click">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <Button Content="Cancel" Click="Cancel_Click">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="txtEmpty" Grid.Row="1" Text="No reservations to show."
                           Foreground="#607464" FontSize="13" Margin="0,60,0,0"
                           HorizontalAlignment="Center" VerticalAlignment="Top"
                           Visibility="Collapsed" IsHitTestVisible="False"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>