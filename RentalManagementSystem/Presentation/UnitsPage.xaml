<UserControl x:Class="RentalManagementSystem.Presentation.UnitsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Section Title -->
        <TextBlock Text="UNITS &amp; ROOMS MANAGEMENT" 
                   FontSize="15" FontWeight="Bold" Foreground="#1E3223" Margin="2,0,0,12"/>

        <!-- Main Content Area for Units -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="16">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="4" BlurRadius="10" Opacity="0.10"/>
            </Border.Effect>
            
            <TextBlock Text="Units / Rooms table or grid will go here..." 
                       FontSize="16" Foreground="#607464" 
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>