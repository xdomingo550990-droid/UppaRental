<UserControl x:Class="RentalManagementSystem.Presentation.UserTypeCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Same green gradient used across Uppa -->
        <LinearGradientBrush x:Key="GreenGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1B3A2A" Offset="0"/>
            <GradientStop Color="#27894C" Offset="1"/>
        </LinearGradientBrush>

        <!-- Big selectable role card (a RadioButton so only one can be chosen) -->
        <Style x:Key="RoleCard" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#1B3A2A"/>
            <Setter Property="Margin" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Width="200" Height="200" CornerRadius="28" Background="White"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.10"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.04" ScaleY="1.04"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource GreenGradient}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#27894C" BlurRadius="32" ShadowDepth="14"
                                                          Direction="270" Opacity="0.40"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Grey "Back" pill -->
        <Style x:Key="BackPill" TargetType="Button">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Width="110" Height="40" CornerRadius="20" Background="#EDEDED">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E0E0E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Round green "next" arrow -->
        <Style x:Key="NextCircle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Width="44" Height="44" CornerRadius="22"
                                Background="{StaticResource GreenGradient}">
                            <Border.Effect>
                                <DropShadowEffect Color="#27894C" BlurRadius="16" ShadowDepth="5"
                                                  Direction="270" Opacity="0.35"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Card -->
    <Border Width="800" Height="480" CornerRadius="30"
            HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FBFCFB" Offset="0"/>
                <GradientStop Color="#E8F0EA" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.2"/>
        </Border.Effect>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

            <!-- Question -->
            <TextBlock Text="ARE YOU A TENANT OR A LANDLORD?" FontSize="24" FontWeight="Bold"
                       Foreground="#1B3A2A" HorizontalAlignment="Center"/>
            <Border Width="28" Height="5" CornerRadius="3" Margin="0,10,0,0"
                    Background="{StaticResource GreenGradient}" HorizontalAlignment="Center"/>
            <TextBlock Text="Choose one to continue." FontSize="13" Foreground="#777777"
                       HorizontalAlignment="Center" Margin="0,12,0,34"/>

            <!-- Role cards -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                <RadioButton x:Name="TenantRadio" Style="{StaticResource RoleCard}"
                             GroupName="UserRole" Tag="Tenant" Checked="Role_Checked">
                    <StackPanel>
                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="42"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Tenant" FontSize="19" FontWeight="Bold" Margin="0,16,0,4"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="I'm looking for a place to rent" FontSize="11" Opacity="0.7"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="150"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="LandlordRadio" Style="{StaticResource RoleCard}"
                             GroupName="UserRole" Tag="Landlord" Checked="Role_Checked">
                    <StackPanel>
                        <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="42"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Landlord" FontSize="19" FontWeight="Bold" Margin="0,16,0,4"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="I own and manage properties" FontSize="11" Opacity="0.7"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="150"/>
                    </StackPanel>
                </RadioButton>

            </StackPanel>

            <!-- Back / Next -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,40,0,0">
                <Button Content="Back" Style="{StaticResource BackPill}" Click="Back_Click"/>
                <Button x:Name="NextButton" Content="&#xE72A;" Style="{StaticResource NextCircle}"
                        Margin="8,0,0,0" IsEnabled="False" Click="Next_Click"/>
            </StackPanel>

        </StackPanel>
    </Border>
</UserControl>
