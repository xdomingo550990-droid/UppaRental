<UserControl x:Class="RentalManagementSystem.Presentation.ProfilePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/PageStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Small helper text under a field -->
            <Style x:Key="HintText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="Foreground" Value="#607464"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="2,6,0,0"/>
            </Style>

            <!-- Thin line between card sections -->
            <Style x:Key="Divider" TargetType="Border">
                <Setter Property="Height" Value="1"/>
                <Setter Property="Background" Value="#E3E9E4"/>
                <Setter Property="Margin" Value="0,0,0,20"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="16,4,16,24">

            <!-- Profile -->
            <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                <Border Style="{StaticResource Card}" Padding="26">
                    <StackPanel>

                        <!-- Title + short description -->
                        <TextBlock Text="Your personal details and how renters can reach you." Style="{StaticResource CardHeading}" Margin="0,0,0,9"/>
                        

                        <!-- Identity summary (name updates as you type) -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Border Width="60" Height="60" CornerRadius="30" Background="#C07156">
                                <TextBlock x:Name="txtAvatar" Text="K" Foreground="White" FontWeight="Bold" FontSize="24"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                                <TextBlock Text="{Binding Text, ElementName=txtFullName, UpdateSourceTrigger=PropertyChanged}"
                                           FontSize="16" FontWeight="Bold" Foreground="#1E3223"
                                           TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Border Background="#E8F0E9" CornerRadius="10" Padding="10,2">
                                        <TextBlock Text="Landlord" FontSize="11" FontWeight="SemiBold" Foreground="#2F5D3A"/>
                                    </Border>
                                    <TextBlock Text="6 units" FontSize="12" Foreground="#607464"
                                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <Border Style="{StaticResource Divider}"/>

                        <!-- Full name -->
                        <TextBlock Text="Full name" Style="{StaticResource FieldLabel}"/>
                        <Border Style="{StaticResource InputBorder}" Margin="0,0,0,18">
                            <TextBox x:Name="txtFullName" Text="Kim Vincent Domingo" Style="{StaticResource PlainTextBox}"/>
                        </Border>

                        <!-- Email + phone side by side -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Email address" Style="{StaticResource FieldLabel}"/>
                                <Border Style="{StaticResource InputBorder}">
                                    <TextBox x:Name="txtEmail" Style="{StaticResource PlainTextBox}"/>
                                </Border>
                                <TextBlock Text="Used for payment and reservation updates."
                                           Style="{StaticResource HintText}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Phone number" Style="{StaticResource FieldLabel}"/>
                                <Border Style="{StaticResource InputBorder}">
                                    <TextBox x:Name="txtPhone" Style="{StaticResource PlainTextBox}"/>
                                </Border>
                                <TextBlock Text="Shown to renters so they can contact you."
                                           Style="{StaticResource HintText}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Footer: save button -->
                        <Border Style="{StaticResource Divider}" Margin="0,24,0,16"/>
                        <Button Content="Save Changes" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Right" Click="Save_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
