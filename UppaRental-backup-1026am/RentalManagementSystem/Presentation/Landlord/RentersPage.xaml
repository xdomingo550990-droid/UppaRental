<UserControl x:Class="RentalManagementSystem.Presentation.RentersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:RentalManagementSystem.Presentation"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/PageStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ============ Form panel styles ============ -->
            <Style x:Key="PanelCaption" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#D9B45A"/>
                <Setter Property="FontSize" Value="10.5"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Margin" Value="1,0,0,10"/>
            </Style>

            <Style x:Key="FormLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#CFE0D3"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="Margin" Value="1,0,0,4"/>
            </Style>

            <!-- Slim off-white text input, 6px corners -->
            <Style x:Key="FormInput" TargetType="TextBox">
                <Setter Property="Height" Value="28"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Foreground" Value="#1C3527"/>
                <Setter Property="Background" Value="#F4F6F4"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="Transparent"
                                    BorderThickness="1.5" CornerRadius="6">
                                <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#D9B45A"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Rounded wrapper for dropdowns and date pickers -->
            <Style x:Key="FormBox" TargetType="Border">
                <Setter Property="Height" Value="28"/>
                <Setter Property="Background" Value="#F4F6F4"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="ClipToBounds" Value="True"/>
            </Style>

            <Style TargetType="ComboBoxItem">
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="Foreground" Value="#1C3527"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="bd" CornerRadius="6" Padding="{TemplateBinding Padding}" Background="Transparent">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#EEF2EE"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#DCEBDF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="FormCombo" TargetType="ComboBox">
                <Setter Property="Height" Value="28"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Foreground" Value="#1C3527"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton Focusable="False" ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent">
                                                <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                                                      Data="M0,0 L4,4 L8,0" Stroke="#5B6B60" StrokeThickness="1.6"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter IsHitTestVisible="False" Margin="10,0,30,0" VerticalAlignment="Center"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                                <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                       AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                    <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                            Background="White" BorderBrush="#D5DDD7" BorderThickness="1"
                                            CornerRadius="8" Padding="4" Margin="0,6,0,16">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.15"/>
                                        </Border.Effect>
                                        <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Date picker without the white patch -->
            <Style TargetType="DatePickerTextBox">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DatePickerTextBox">
                            <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" VerticalAlignment="Center"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="DatePicker">
                <Setter Property="Height" Value="26"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="8,0,4,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="#1C3527"/>
            </Style>

            <!-- Slim action buttons -->
            <Style x:Key="FormButton" TargetType="Button">
                <Setter Property="Height" Value="30"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" Padding="12,0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="FormButtonSave" TargetType="Button" BasedOn="{StaticResource FormButton}">
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="White"/>
                <Setter Property="Foreground" Value="#1C3527"/>
            </Style>
            <Style x:Key="FormButtonClear" TargetType="Button" BasedOn="{StaticResource FormButton}">
                <Setter Property="Background" Value="#26FFFFFF"/>
                <Setter Property="BorderBrush" Value="#4DFFFFFF"/>
                <Setter Property="Foreground" Value="White"/>
            </Style>
            <Style x:Key="FormButtonDelete" TargetType="Button" BasedOn="{StaticResource FormButton}">
                <Setter Property="Background" Value="#B94A48"/>
                <Setter Property="BorderBrush" Value="#B94A48"/>
                <Setter Property="Foreground" Value="White"/>
            </Style>

            <!-- Show/hide helper for reservation-only text in the table -->
            <BooleanToVisibilityConverter x:Key="B2V"/>

            <!-- Segmented "New Renter | Reservation" switch (sits on the dark form panel) -->
            <Style x:Key="ModeTab" TargetType="RadioButton">
                <Setter Property="Foreground" Value="#CFE0D3"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="bd" CornerRadius="7" Padding="16,6" Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  RecognizesAccessKey="False"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#1FFFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="White"/>
                                    <Setter Property="Foreground" Value="#1C3527"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Light "Property / Unit" filter box that sits above the table -->
            <Style x:Key="FilterBox" TargetType="Border">
                <Setter Property="Height" Value="30"/>
                <Setter Property="Width" Value="200"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#C5D4C9"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="ClipToBounds" Value="True"/>
            </Style>

            <!-- Slim Unpaid | Paid switch (same look as the New Renter | Reservation switch) -->
            <Style x:Key="PayTab" TargetType="RadioButton">
                <Setter Property="Foreground" Value="#CFE0D3"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="bd" CornerRadius="6" Padding="18,3" Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  RecognizesAccessKey="False"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#1FFFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="White"/>
                                    <Setter Property="Foreground" Value="#1C3527"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 1. Header -->
            <RowDefinition Height="Auto"/>
            <!-- 2. Renter / Reservation form panel -->
            <RowDefinition Height="*"/>
            <!-- 3. Table card (Filters + DataGrid) -->
        </Grid.RowDefinitions>

        <!-- 1. Header + Property / Unit filter -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Manage tenant profiles, reservations, lease periods, and rent status."
                       Style="{StaticResource PageSubtitle}" FontWeight="SemiBold" Foreground="#1E3223"
                       VerticalAlignment="Center" Margin="0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Property / Unit" FontSize="12" FontWeight="SemiBold" Foreground="#1E3223"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Border Style="{StaticResource FilterBox}">
                    <ComboBox x:Name="UnitFilterCombo" Style="{StaticResource FormCombo}"
                              SelectionChanged="UnitFilter_Changed"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- 2. Inline form panel + divider -->
        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <Border CornerRadius="12" Padding="26,18,26,8">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1C3527" Offset="0"/>
                        <GradientStop Color="#24432F" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect Color="#1C3527" Direction="270" ShadowDepth="5" BlurRadius="22" Opacity="0.22"/>
                </Border.Effect>

                <StackPanel>
                    <!-- Panel title + entry type switch -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Border Width="4" Height="30" CornerRadius="2" Background="#D9B45A"
                                    VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="PanelTitle" Text="Renter Details" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock x:Name="PanelSubtitle" Text="Add a new renter, or click a row in the table to edit it."
                                           FontSize="11.5" Foreground="#A9C2B0" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- New Renter | Reservation -->
                        <Border Grid.Column="1" Background="#26FFFFFF" CornerRadius="9" Padding="3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="rbModeRenter" Content="New Renter" GroupName="EntryMode" IsChecked="True"
                                             Style="{StaticResource ModeTab}" Checked="Mode_Checked"/>
                                <RadioButton x:Name="rbModeReservation" Content="Reservation" GroupName="EntryMode"
                                             Style="{StaticResource ModeTab}" Checked="Mode_Checked"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="176"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT: tenant profile -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="TENANT PROFILE" Style="{StaticResource PanelCaption}"/>

                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="Renter Name" Style="{StaticResource FormLabel}"/>
                                <TextBox x:Name="NameBox" Style="{StaticResource FormInput}"/>
                            </StackPanel>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Contact No" Style="{StaticResource FormLabel}"/>
                                    <TextBox x:Name="ContactBox" Style="{StaticResource FormInput}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Email Address" Style="{StaticResource FormLabel}"/>
                                    <TextBox x:Name="EmailBox" Style="{StaticResource FormInput}"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="Home Address" Style="{StaticResource FormLabel}"/>
                                <TextBox x:Name="AddressBox" Style="{StaticResource FormInput}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- divider -->
                        <Border Grid.Column="1" Width="1" Background="#26FFFFFF" HorizontalAlignment="Center"/>

                        <!-- MIDDLE: lease and unit -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="LEASE &amp; UNIT" Style="{StaticResource PanelCaption}"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Assigned Property" Style="{StaticResource FormLabel}"/>
                                    <Border Style="{StaticResource FormBox}">
                                        <ComboBox x:Name="UnitCombo" Style="{StaticResource FormCombo}"
                                                  SelectionChanged="UnitCombo_SelectionChanged"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Rental Term" Style="{StaticResource FormLabel}"/>
                                    <Border Style="{StaticResource FormBox}">
                                        <ComboBox x:Name="TermCombo" Style="{StaticResource FormCombo}"
                                                  SelectionChanged="Term_Changed"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,0,0,8">
                                <TextBlock x:Name="TermLabel" Text="Lease Term" Style="{StaticResource FormLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource FormBox}">
                                        <DatePicker x:Name="StartPicker" SelectedDateChanged="Date_Changed"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="to" Foreground="#CFE0D3" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Margin="12,0"/>
                                    <Border Grid.Column="2" Style="{StaticResource FormBox}">
                                        <DatePicker x:Name="EndPicker" SelectedDateChanged="Date_Changed"/>
                                    </Border>
                                </Grid>
                            </StackPanel>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="RentLabel" Text="Monthly Rent (&#x20B1;)" Style="{StaticResource FormLabel}"/>
                                    <TextBox x:Name="RentBox" Style="{StaticResource FormInput}" TextChanged="Rent_TextChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Lease Status" Style="{StaticResource FormLabel}"/>
                                    <Border Style="{StaticResource FormBox}">
                                        <ComboBox x:Name="StatusCombo" Style="{StaticResource FormCombo}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- divider -->
                        <Border Grid.Column="3" Width="1" Background="#26FFFFFF" HorizontalAlignment="Center"/>

                        <!-- RIGHT: actions -->
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="ACTIONS" Style="{StaticResource PanelCaption}"/>

                            <Button x:Name="SaveButton" Style="{StaticResource FormButtonSave}" Click="Save_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               Foreground="#1F9D55" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SaveText" Text="Save Renter" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource FormButtonClear}" Click="Clear_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE75C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Clear Fields" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource FormButtonDelete}" Click="Delete_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="DeleteText" Text="Move Out Renter" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <TextBlock x:Name="ArchiveHint" Text="Move Out archives the selected record and frees the unit. Nothing is erased."
                                       FontSize="11" Foreground="#A9C2B0" TextWrapping="Wrap" Margin="2,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Reservation only: payment received + hold-until date -->
                    <Grid x:Name="ReservationFields" Visibility="Collapsed" Margin="0,4,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="176"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Payment Received" Style="{StaticResource FormLabel}"/>
                            <Border Background="#26FFFFFF" CornerRadius="8" Padding="3" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="rbPayUnpaid" Content="Unpaid" GroupName="ResPay" IsChecked="True"
                                                 Style="{StaticResource PayTab}"/>
                                    <RadioButton x:Name="rbPayPaid" Content="Paid" GroupName="ResPay"
                                                 Style="{StaticResource PayTab}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Hold Until / Expiry Date" Style="{StaticResource FormLabel}"/>
                            <Border Style="{StaticResource FormBox}">
                                <DatePicker x:Name="HoldPicker"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Reservation only: total rent (and the 20% downpayment for long-term) -->
                    <Border x:Name="ReservationStrip" Visibility="Collapsed" Margin="0,4,0,8" Padding="14,9"
                            Background="#1FD9B45A" BorderBrush="#4DD9B45A" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock x:Name="ResTotalText" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="#F0E2B0" TextWrapping="Wrap"/>
                                <TextBlock x:Name="ResNoteText" Text="A 20% downpayment is required to reserve the unit."
                                           FontSize="11" Foreground="#A9C2B0" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel x:Name="DownPanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                <TextBlock Text="Downpayment (20%)" FontSize="12" Foreground="#CFE0D3"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock x:Name="ResDownText" FontSize="18" FontWeight="Bold" Foreground="#D9B45A"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- New Renter only: move-in payments -->
                    <Border x:Name="MoveInStrip" Margin="0,4,0,8" Padding="14,10"
                            Background="#1FD9B45A" BorderBrush="#4DD9B45A" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="AdvanceLabel" Text="1 Month Advance (&#x20B1;)" Style="{StaticResource FormLabel}"/>
                                <TextBox x:Name="AdvanceBox" Style="{StaticResource FormInput}" TextChanged="Money_TextChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Security Deposit (&#x20B1;)" Style="{StaticResource FormLabel}"/>
                                <TextBox x:Name="DepositBox" Style="{StaticResource FormInput}" TextChanged="Money_TextChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Less: Reservation Credit (&#x20B1;)" Style="{StaticResource FormLabel}"/>
                                <TextBox x:Name="CreditBox" Style="{StaticResource FormInput}" TextChanged="Money_TextChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="6" VerticalAlignment="Bottom" MinWidth="120">
                                <TextBlock Text="Due at move-in" FontSize="11" Foreground="#CFE0D3" HorizontalAlignment="Right"/>
                                <TextBlock x:Name="NetDueText" FontSize="18" FontWeight="Bold" Foreground="#D9B45A"
                                           HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="FormMessage" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                               Margin="2,4,0,10" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- Divider -->
            <Border Height="1" Background="#C5D4C9" Margin="0,16,0,0"/>
        </StackPanel>

        <!-- 3. One table for renters AND reservations -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Filter Pills -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                    <RadioButton x:Name="rbAll" Content="All" Tag="All" IsChecked="True"
                                 Style="{StaticResource FilterPill}" Checked="Filter_Checked"/>
                    <RadioButton x:Name="rbActive" Content="Active" Tag="Active"
                                 Style="{StaticResource FilterPill}" Checked="Filter_Checked"/>
                    <RadioButton x:Name="rbPending" Content="Pending" Tag="Pending"
                                 Style="{StaticResource FilterPill}" Checked="Filter_Checked"/>
                    <RadioButton x:Name="rbReservations" Content="Reservations" Tag="Reservation"
                                 Style="{StaticResource FilterPill}" Checked="Filter_Checked"/>
                    <RadioButton x:Name="rbPast" Content="Past" Tag="Past"
                                 Style="{StaticResource FilterPill}" Checked="Filter_Checked"/>
                </StackPanel>

                <!-- Renters + Reservations Table -->
                <DataGrid Grid.Row="1" x:Name="dgRenters" Style="{StaticResource AppDataGrid}"
                          SelectionChanged="Renters_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="RENTER" Width="210">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="32" Height="32" CornerRadius="16" Background="#1E3223">
                                            <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="Bold" FontSize="13"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Renter or Reservation -->
                        <DataGridTemplateColumn Header="TYPE" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border x:Name="badge" CornerRadius="10" Padding="10,3" Background="#E4EEE6"
                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock x:Name="lbl" Text="{Binding TypeText}" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="#2F5C3E"/>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsReservation}" Value="True">
                                            <Setter TargetName="badge" Property="Background" Value="#FBF3DC"/>
                                            <Setter TargetName="lbl" Property="Foreground" Value="#7A5A12"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="UNIT" Binding="{Binding Unit}" Width="90"/>
                        <DataGridTextColumn Header="CONTACT" Binding="{Binding Contact}" Width="140"/>
                        <DataGridTextColumn Header="LEASE PERIOD" Binding="{Binding LeasePeriod}" Width="*"/>

                        <!-- Sub-line: 20% downpayment, short-term days, or unpaid balance -->
                        <DataGridTemplateColumn Header="RATE" Width="175">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding RentText}"/>
                                        <TextBlock Text="{Binding SubText}" FontSize="11" Foreground="#7A5A12"
                                                   Visibility="{Binding HasSubText, Converter={StaticResource B2V}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="STATUS" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource StatusBadge}">
                                        <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="Bold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="ACTIONS" Width="230">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="View" Style="{StaticResource LinkButton}" Click="View_Click"/>
                                        <Button Content="Edit" Style="{StaticResource LinkButton}" Click="Edit_Click"/>
                                        <Button Content="Move-In" Style="{StaticResource LinkButton}" Click="Promote_Click"
                                                ToolTip="Promote to an Active renter"
                                                Visibility="{Binding CanPromote, Converter={StaticResource B2V}}"/>
                                        <Button Content="Move Out" Style="{StaticResource LinkButton}" Click="MoveOut_Click"
                                                Foreground="#B94A48" ToolTip="Terminate the lease and archive the renter"
                                                Visibility="{Binding CanMoveOut, Converter={StaticResource B2V}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>