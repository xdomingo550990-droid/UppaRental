<UserControl x:Class="RentalManagementSystem.Presentation.UserTypeCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Green gradient -->
        <LinearGradientBrush x:Key="GreenGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1B3A2A" Offset="0"/>
            <GradientStop Color="#27894C" Offset="1"/>
        </LinearGradientBrush>

        <!-- Smooth Animated Role Card (Tenant / Landlord Radio Buttons) -->
        <Style x:Key="RoleCard" TargetType="RadioButton">
            <Setter Property="Width" Value="170"/>
            <Setter Property="Height" Value="160"/>
            <Setter Property="Margin" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="White" CornerRadius="16"
                            BorderThickness="2" BorderBrush="#E5E5E5"
                            RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="scaleTransform" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect x:Name="cardShadow" BlurRadius="12" ShadowDepth="2" Opacity="0.08" Color="Black"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- Radio Button Selected State -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#27894C"/>
                                <Setter TargetName="bd" Property="Background" Value="#EAF5EE"/>
                            </Trigger>

                            <!-- Smooth Hover In -->
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="scaleTransform" Storyboard.TargetProperty="ScaleX"
                                                     To="1.04" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="scaleTransform" Storyboard.TargetProperty="ScaleY"
                                                     To="1.04" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="cardShadow" Storyboard.TargetProperty="Opacity"
                                                     To="0.2" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="cardShadow" Storyboard.TargetProperty="BlurRadius"
                                                     To="20" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>

                            <!-- Smooth Hover Out -->
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="scaleTransform" Storyboard.TargetProperty="ScaleX"
                                                     To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="scaleTransform" Storyboard.TargetProperty="ScaleY"
                                                     To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="cardShadow" Storyboard.TargetProperty="Opacity"
                                                     To="0.08" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="cardShadow" Storyboard.TargetProperty="BlurRadius"
                                                     To="12" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Smooth Animated Back Button -->
        <Style x:Key="BackPill" TargetType="Button">
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Width="110" Height="40" CornerRadius="20"
                            Background="#EDEDED" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="scaleTransform" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- Smooth Hover In -->
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                    To="#E0E0E0" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="scaleTransform" Storyboard.TargetProperty="ScaleX"
                                                     To="1.03" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="scaleTransform" Storyboard.TargetProperty="ScaleY"
                                                     To="1.03" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>

                            <!-- Smooth Hover Out -->
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                    To="#EDEDED" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="scaleTransform" Storyboard.TargetProperty="ScaleX"
                                                     To="1" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="scaleTransform" Storyboard.TargetProperty="ScaleY"
                                                     To="1" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Smooth Animated Next Arrow Button -->
        <Style x:Key="NextCircle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Width="44" Height="44" CornerRadius="22"
                            Background="{StaticResource GreenGradient}"
                            RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="scaleTransform" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect x:Name="shadow" Color="#27894C" BlurRadius="16" ShadowDepth="5"
                                              Direction="270" Opacity="0.35"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- Disabled State -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>

                            <!-- Smooth Hover In -->
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="scaleTransform" Storyboard.TargetProperty="ScaleX"
                                                     To="1.08" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="scaleTransform" Storyboard.TargetProperty="ScaleY"
                                                     To="1.08" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="shadow" Storyboard.TargetProperty="Opacity"
                                                     To="0.5" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="shadow" Storyboard.TargetProperty="BlurRadius"
                                                     To="22" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>

                            <!-- Smooth Hover Out -->
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="scaleTransform" Storyboard.TargetProperty="ScaleX"
                                                     To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="scaleTransform" Storyboard.TargetProperty="ScaleY"
                                                     To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="shadow" Storyboard.TargetProperty="Opacity"
                                                     To="0.35" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="shadow" Storyboard.TargetProperty="BlurRadius"
                                                     To="16" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    
    
    <!-- Card Body -->
    <Border Width="800" Height="480" CornerRadius="30"
            HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FBFCFB" Offset="0"/>
                <GradientStop Color="#E8F0EA" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.2"/>
        </Border.Effect>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

            <!-- Question Header -->
            <TextBlock Text="ARE YOU A TENANT OR A LANDLORD?" FontSize="24" FontWeight="Bold"
                       Foreground="#1B3A2A" HorizontalAlignment="Center"/>
            <Border Width="28" Height="5" CornerRadius="3" Margin="0,10,0,0"
                    Background="{StaticResource GreenGradient}" HorizontalAlignment="Center"/>
            <TextBlock Text="Choose one to continue." FontSize="13" Foreground="#777777"
                       HorizontalAlignment="Center" Margin="0,12,0,34"/>

            <!-- Role Selection Options -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                <RadioButton x:Name="TenantRadio" Style="{StaticResource RoleCard}"
                             GroupName="UserRole" Tag="Tenant" Checked="Role_Checked">
                    <StackPanel>
                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="42"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Tenant" FontSize="19" FontWeight="Bold" Margin="0,16,0,4"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="I'm looking for a place to rent" FontSize="11" Opacity="0.7"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="150"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="LandlordRadio" Style="{StaticResource RoleCard}"
                             GroupName="UserRole" Tag="Landlord" Checked="Role_Checked">
                    <StackPanel>
                        <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="42"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Landlord" FontSize="19" FontWeight="Bold" Margin="0,16,0,4"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="I own and manage properties" FontSize="11" Opacity="0.7"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="150"/>
                    </StackPanel>
                </RadioButton>

            </StackPanel>

            <!-- Navigation Controls -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,40,0,0">
                <Button Content="Back" Style="{StaticResource BackPill}" Click="Back_Click"/>
                <Button x:Name="NextButton" Content="&#xE72A;" Style="{StaticResource NextCircle}"
                        Margin="8,0,0,0" IsEnabled="False" Click="Next_Click"/>
            </StackPanel>

        </StackPanel>
    </Border>
</UserControl>