<UserControl x:Class="RentalManagementSystem.Presentation.TenantOverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/PropertyCardStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Heading -->
        <TextBlock Grid.Row="0" HorizontalAlignment="Center" Margin="0,8,0,20"
                   FontSize="30" FontWeight="Bold" Foreground="#1E3223">
            <Run Text="Ready to Find Your "/>
            <Run Text="Dream" FontFamily="Georgia" FontStyle="Italic" Foreground="#C9972B"/>
            <Run Text=" Property?"/>
        </TextBlock>

        <!-- Category chips: same categories as the sections below -->
        <WrapPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,14">
            <RadioButton Style="{StaticResource ChipStyle}" Content="All" Tag="All" IsChecked="True" Checked="Category_Checked"/>
            <RadioButton Style="{StaticResource ChipStyle}" Content="Most Popular" Tag="Popular" Checked="Category_Checked"/>
            <RadioButton Style="{StaticResource ChipStyle}" Content="Most Affordable" Tag="Affordable" Checked="Category_Checked"/>
            <RadioButton Style="{StaticResource ChipStyle}" Content="Available" Tag="Available" Checked="Category_Checked"/>
            <RadioButton Style="{StaticResource ChipStyle}" Content="Reserved" Tag="Reserved" Checked="Category_Checked"/>
            <RadioButton Style="{StaticResource ChipStyle}" Content="Occupied" Tag="Occupied" Checked="Category_Checked"/>
            <RadioButton Style="{StaticResource ChipStyle}" Content="Long Term" Tag="Long" Checked="Category_Checked"/>
            <RadioButton Style="{StaticResource ChipStyle}" Content="Short Term" Tag="Short" Checked="Category_Checked"/>
        </WrapPanel>

        <!-- Category sections container -->
        <Grid Grid.Row="2">
            <!-- Scrollable List of Posted Rooms -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="icSections" Margin="0,0,8,16"
                              ItemTemplate="{StaticResource GallerySectionTemplate}"
                              Button.Click="ReadMore_Click"/>
            </ScrollViewer>

            <!-- Empty State Message (Visible automatically when icSections has 0 items) -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,40">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=icSections, Path=HasItems}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="40" 
                           Foreground="#A0A0A0" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock Text="No rooms posted yet" FontSize="20" FontWeight="SemiBold" 
                           Foreground="#1E3223" HorizontalAlignment="Center"/>
                <TextBlock Text="There are currently no rooms available in this category." 
                           FontSize="14" Foreground="#777777" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>