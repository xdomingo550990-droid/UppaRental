<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:RentalManagementSystem.Presentation">
    <!-- Category chip -->
    <Style x:Key="ChipStyle" TargetType="RadioButton">
        <Setter Property="GroupName" Value="Category"/>
        <Setter Property="Foreground" Value="#1E3223"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Margin" Value="0,0,10,10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="chip" Padding="20,9" CornerRadius="18" Background="White">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.12"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="chip" Property="Background" Value="#F1F5F2"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="chip" Property="Background" Value="#1E3223"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Section heading + divider -->
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#1E3223"/>
    </Style>
    <Style x:Key="SectionSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="#607464"/>
        <Setter Property="Margin" Value="0,3,0,16"/>
    </Style>
    <Style x:Key="SectionDivider" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="0,8,0,24"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00A9BDAD" Offset="0"/>
                    <GradientStop Color="#FFA9BDAD" Offset="0.5"/>
                    <GradientStop Color="#00A9BDAD" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Status badge on photos -->
    <Style x:Key="PropStatusBadge" TargetType="Border">
        <Setter Property="Background" Value="#E8ECE9"/>
        <Setter Property="TextElement.Foreground" Value="#5C7060"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="10,3"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="Available">
                <Setter Property="Background" Value="#D0F0C0"/>
                <Setter Property="TextElement.Foreground" Value="#004225"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Reserved">
                <Setter Property="Background" Value="#FFF3C4"/>
                <Setter Property="TextElement.Foreground" Value="#8C6B00"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Occupied">
                <Setter Property="Background" Value="#FFDCD8"/>
                <Setter Property="TextElement.Foreground" Value="#A81C0C"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Draft">
                <Setter Property="Background" Value="#E6E1F5"/>
                <Setter Property="TextElement.Foreground" Value="#4B3E8C"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Status as plain colored text (list view) -->
    <Style x:Key="PropStatusText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#5C7060"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="Available">
                <Setter Property="Foreground" Value="#27894C"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Reserved">
                <Setter Property="Foreground" Value="#8C6B00"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Occupied">
                <Setter Property="Foreground" Value="#A81C0C"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Draft">
                <Setter Property="Foreground" Value="#6B5BA8"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Detail row text and icons -->
    <Style x:Key="DetailText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#5C7060"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="IconEmoji" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Emoji"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="#27894C"/>
        <Setter Property="Width" Value="20"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="IconMdl2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#27894C"/>
        <Setter Property="Width" Value="20"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- "Read more" link -->
    <Style x:Key="ReadMoreButton" TargetType="Button">
        <Setter Property="Foreground" Value="#27894C"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#1E3223"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Edit / Delete links (only visible on pages that set Manage.ActionsVisibility) -->
    <Style x:Key="ManageButton" TargetType="Button">
        <Setter Property="Foreground" Value="#27894C"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,14,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="0,2">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#1E3223"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="DeleteButton" TargetType="Button" BasedOn="{StaticResource ManageButton}">
        <Setter Property="Foreground" Value="#A81C0C"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#6E1208"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 4 cards per row -->
    <ItemsPanelTemplate x:Key="FourColumnPanel">
        <UniformGrid Columns="4"/>
    </ItemsPanelTemplate>

    <!-- ===== GALLERY: one property card (photo, name, location, short description, details, price) ===== -->
    <DataTemplate x:Key="PropertyCardTemplate">
        <Border Background="White" CornerRadius="16" Padding="12" Margin="0,0,16,16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.10" Color="#000000"/>
            </Border.Effect>
            <StackPanel>

                <!-- Photo with status badge and heart -->
                <Border Height="150" CornerRadius="12">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Photo}" Stretch="UniformToFill"/>
                    </Border.Background>
                    <Grid>
                        <Border Style="{StaticResource PropStatusBadge}"
                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0">
                            <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold"/>
                        </Border>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0"
                                Width="28" Height="28" CornerRadius="14" Background="#CCFFFFFF">
                            <TextBlock Text="♡" FontFamily="Segoe UI Symbol" FontSize="14" Foreground="#1E3223"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Name + location + short description -->
                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="#1E3223"
                           Margin="2,12,0,0" TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal" Margin="2,5,0,0">
                    <TextBlock Text="&#xE707;" Style="{StaticResource IconMdl2}" Foreground="#8A9A8D" Width="16"/>
                    <TextBlock Text="{Binding Location}" FontSize="11" Foreground="#8A9A8D"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#5C7060"
                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                           LineStackingStrategy="BlockLineHeight" LineHeight="15" Height="30" Margin="2,8,0,0"/>

                <!-- Details: bedrooms, bathrooms, size, lease term -->
                <Grid Margin="2,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="🛏" Style="{StaticResource IconEmoji}"/>
                        <TextBlock Text="{Binding BedroomsText}" Style="{StaticResource DetailText}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="🛁" Style="{StaticResource IconEmoji}"/>
                        <TextBlock Text="{Binding BathroomsText}" Style="{StaticResource DetailText}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="&#xE740;" Style="{StaticResource IconMdl2}"/>
                        <TextBlock Text="{Binding SqFtText}" Style="{StaticResource DetailText}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="&#xE787;" Style="{StaticResource IconMdl2}"/>
                        <TextBlock Text="{Binding Term}" Style="{StaticResource DetailText}"/>
                    </StackPanel>
                </Grid>

                <!-- Price + Read more -->
                <Border BorderBrush="#EAEFEB" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="2,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PriceText}" FontSize="16" FontWeight="Bold" Foreground="#1E3223"/>
                            <TextBlock Text="{Binding PriceUnit}" FontSize="11" Foreground="#8A9A8D"
                                       VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Read more  ›" Tag="Read" Style="{StaticResource ReadMoreButton}"
                                VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Edit / Delete (hidden unless the page turns them on) -->
                <StackPanel Orientation="Horizontal" Margin="2,8,0,0"
                            Visibility="{Binding Path=(local:Manage.ActionsVisibility), RelativeSource={RelativeSource Self}}">
                    <Button Content="Edit" Tag="Edit" Style="{StaticResource ManageButton}"/>
                    <Button Content="Delete" Tag="Delete" Style="{StaticResource DeleteButton}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ===== LIST: one property as plain text (name, then description) ===== -->
    <DataTemplate x:Key="PropertyRowTemplate">
        <Border Padding="0,14" BorderBrush="#EEF2EF" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" Foreground="#1E3223"/>
                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#5C7060"
                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="#8A9A8D"
                               TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="24,0,0,0">
                    <TextBlock Text="{Binding PriceWithUnit}" FontSize="14" FontWeight="Bold" Foreground="#1E3223"
                               HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource PropStatusText}"
                               HorizontalAlignment="Right" Margin="0,4,0,0"/>

                    <!-- Edit / Delete (hidden unless the page turns them on) -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0"
                                Visibility="{Binding Path=(local:Manage.ActionsVisibility), RelativeSource={RelativeSource Self}}">
                        <Button Content="Edit" Tag="Edit" Style="{StaticResource ManageButton}"/>
                        <Button Content="Delete" Tag="Delete" Style="{StaticResource DeleteButton}" Margin="0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- ===== One category section: gallery version ===== -->
    <DataTemplate x:Key="GallerySectionTemplate">
        <StackPanel>
            <Border Style="{StaticResource SectionDivider}" Visibility="{Binding DividerVisibility}"/>
            <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource SectionSubtitle}"/>
            <ItemsControl ItemsSource="{Binding Items}"
                          ItemTemplate="{StaticResource PropertyCardTemplate}"
                          ItemsPanel="{StaticResource FourColumnPanel}"/>
        </StackPanel>
    </DataTemplate>

    <!-- ===== One category section: text list version ===== -->
    <DataTemplate x:Key="ListSectionTemplate">
        <StackPanel>
            <Border Style="{StaticResource SectionDivider}" Visibility="{Binding DividerVisibility}"/>
            <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource SectionSubtitle}"/>
            <Border Background="White" CornerRadius="14" Padding="22,2" Margin="0,0,0,8">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.08" Color="#000000"/>
                </Border.Effect>
                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource PropertyRowTemplate}"/>
            </Border>
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>